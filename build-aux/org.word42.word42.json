{
  "app-id": "org.word42.word42",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "word42",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host",
    "--socket=cups"
  ],
  "modules": [
    {
      "name": "enchant",
      "buildsystem": "autotools",
      "config-opts": [ "--disable-static", "--with-hunspell" ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/rrthomas/enchant/releases/download/v2.8.21/enchant-2.8.21.tar.gz",
          "sha256": "dd2a762697c463148a8f59867089a5ebf2dd1449d869f93764b76c12bcf8acc0"
        }
      ]
    },
    {
      "name": "hyphen",
      "buildsystem": "autotools",
      "config-opts": [ "--disable-static" ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/hunspell/hyphen-2.8.8.tar.gz",
          "sha256": "304636d4eccd81a14b6914d07b84c79ebb815288c76fe027b9ebff6ff24d5705"
        }
      ]
    },
    {
      "name": "lexbor",
      "buildsystem": "cmake-ninja",
      "config-opts": [ "-DCMAKE_BUILD_TYPE=Release", "-DLEXBOR_BUILD_TESTS=OFF" ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/lexbor/lexbor.git",
          "tag": "v3.0.1",
          "commit": "7e278c0188489bfce6b71ced0cc900cbb31e6244"
        }
      ]
    },
    {
      "name": "word42",
      "buildsystem": "meson",
      "config-opts": [ "--buildtype=release" ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/office-42/word42.git",
          "branch": "main"
        }
      ]
    }
  ]
}
