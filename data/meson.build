w42_resources = gnome.compile_resources(
  'w42-resources',
  'word42.gresource.xml',
  source_dir: meson.current_source_dir(),
  c_name: 'w42',
)

# The icon theme travels in its own bundle, whose manifest is regenerated by
# icons/make-icons.py alongside the icons themselves, so the two cannot drift
# apart the way a hand-maintained list would.
w42_icon_resources = gnome.compile_resources(
  'w42-icon-resources',
  'icons/icons.gresource.xml',
  source_dir: meson.current_source_dir() / 'icons',
  c_name: 'w42_icons',
)

icon_sizes = ['16x16', '24x24', '32x32', '48x48', '64x64', '128x128', '256x256']

if host_machine.system() not in ['windows', 'darwin']
  install_data('org.word42.word42.desktop',
               install_dir: get_option('datadir') / 'applications')
  install_data('org.word42.word42.metainfo.xml',
               install_dir: get_option('datadir') / 'metainfo')

  # The application icon also goes into hicolor, so the launcher, the window
  # manager and the alt-tab switcher can find it by name.
  foreach size : icon_sizes
    install_data('icons' / size / 'apps' / 'org.word42.word42.png',
                 install_dir: get_option('datadir') / 'icons' / 'hicolor'
                              / size / 'apps')
  endforeach

  install_data('icons/scalable/apps/org.word42.word42.svg',
               install_dir: get_option('datadir') / 'icons' / 'hicolor'
                            / 'scalable' / 'apps')
endif
