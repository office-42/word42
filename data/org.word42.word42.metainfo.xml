<component type="desktop-application">
  <id>org.word42.word42</id>
  <name>word42</name>
  <summary>A classic word processor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.word42">
    <name>Andreas Røsdal</name>
  </developer>
  <description>
    <p>
      word42 is a word processor written from scratch in C on GTK 4, Pango
      and Cairo, in the classic style of the early 1990s: a menu bar, two
      toolbars, a ruler and a page. Styles, tables, footnotes, columns,
      frames, pictures, headers and footers, spelling, printing, and files
      in RTF, .docx, .doc, OpenDocument, AbiWord, PDF and HTML.
    </p>
  </description>
  <launchable type="desktop-id">org.word42.word42.desktop</launchable>
  <url type="homepage">https://word42.org</url>
  <url type="vcs-browser">https://github.com/office-42/word42</url>
  <url type="bugtracker">https://github.com/office-42/word42/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/office-42/word42/main/docs/images/screenshot.png</image>
      <caption>A document written in Word, opened from .doc</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <provides>
    <binary>word42</binary>
  </provides>
</component>
