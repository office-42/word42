[Desktop Entry]
Type=Application
Name=word42
GenericName=Word Processor
Comment=A classic word processor: menus, toolbars, a ruler and a page
Exec=word42 %F
Icon=org.word42.word42
Terminal=false
Categories=Office;WordProcessor;GTK;
MimeType=application/vnd.oasis.opendocument.text;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/x-abiword;text/plain;text/rtf;application/rtf;application/msword;text/html;application/pdf;
StartupNotify=true
