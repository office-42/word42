<pagesize pagetype="Letter" orientation="portrait" width="8.500000" height="11.000000" units="in" page-scale="1.000000"/>
<section footer="1" header="0" xid="2" props="page-margin-right:1.0000in; page-width:8.5000in; page-margin-header:1.0000in; page-margin-left:1.0000in; page-margin-footer:1.0000in; page-margin-bottom:3.810000cm; page-orientation:portrait; page-margin-top:3.810000cm; page-height:11.0000in">
<p style="Title" xid="3" props="margin-bottom:0.0417in; margin-top:0.1667in">Word42 feature tour</p>
<p style="Standard" xid="4">This document is here to be read back.  It uses what the model can hold, so that a program that writes it out again in its own hand gives a file worth reading.</p>
<p style="Heading 1" xid="5" props="margin-bottom:0.0833in; margin-top:0.1667in">Character formatting</p>
<p style="Standard" xid="6"><c props="font-weight:bold">Bold</c>, <c props="font-style:italic">italic</c>, <c props="text-decoration:underline">underline</c>, <c props="text-decoration:line-through">struck through</c>, <c props="color:#c00000">coloured</c>, <c props="bgcolor:#ffff00">highlighted</c>, small capitals, and a <c props="text-position:superscript">superscript</c>.</p>
<p style="Heading 1" xid="7" props="margin-bottom:0.0833in; margin-top:0.1667in">Paragraphs and lists</p>
<p style="Standard" xid="8" props="text-align:justify; margin-top:0.1667in; line-height:1.500000; text-indent:0.2500in; margin-left:0.5000in">This paragraph is justified, indented on the left, and set with space above it, so that a reader can tell whether those survived the trip through a file format and back again.</p>
<p level="1" listid="1000" parentid="0" xid="9" props="margin-left:0.635000cm; font-size:10pt; text-indent:-0.635000cm; field-font:Symbol; font-weight:normal; list-style:Bullet List; text-align:left; font-style:normal"><field type="list_label" xid="10"></field>	The first item of a bulleted list</p>
<p level="1" listid="1000" parentid="0" xid="11" props="margin-left:0.635000cm; font-size:10pt; text-indent:-0.635000cm; field-font:Symbol; font-weight:normal; list-style:Bullet List; text-align:left; font-style:normal"><field type="list_label" xid="12"></field>	The second item of a bulleted list</p>
<p level="1" listid="1009" parentid="0" xid="13" props="margin-left:0.635000cm; font-size:10pt; text-indent:-0.635000cm; list-style:Numbered List; font-weight:normal; field-font:NULL; text-align:left; font-style:normal"><field type="list_label" xid="14"></field>	The first item of a numbered list</p>
<p level="1" listid="1009" parentid="0" xid="15" props="margin-left:0.635000cm; font-size:10pt; text-indent:-0.635000cm; list-style:Numbered List; font-weight:normal; field-font:NULL; text-align:left; font-style:normal"><field type="list_label" xid="16"></field>	The second item of a numbered list</p>
<p style="Heading 1" xid="17" props="margin-bottom:0.0833in; margin-top:0.1667in">Tabs and leaders</p>
<p style="Standard" xid="18">Chapter one	7</p>
<p style="Standard" xid="19">Chapter two	19</p>
<p style="Heading 1" xid="20" props="margin-bottom:0.0833in; margin-top:0.1667in"><bookmark type="start" name="the-table" xid="21"/>A table<bookmark type="end" name="the-table" xid="22"/></p>
<table xid="23" props="table-column-props:2.1667in/2.1667in/2.1667in/; table-row-heights:///; table-width:6.5000in">
<cell xid="24" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:1; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:0; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:1; top-attach:0">
<p style="Standard" xid="25">Format</p>
</cell>
<cell xid="26" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:2; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:1; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:1; top-attach:0">
<p style="Standard" xid="27">Reads</p>
</cell>
<cell xid="28" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:3; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:2; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:1; top-attach:0">
<p style="Standard" xid="29">Writes</p>
</cell>
<cell xid="30" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:1; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:0; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:2; top-attach:1">
<p style="Standard" xid="31">OpenDocument</p>
</cell>
<cell xid="32" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:2; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:1; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:2; top-attach:1">
<p style="Standard" xid="33">yes</p>
</cell>
<cell xid="34" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:3; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:2; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:2; top-attach:1">
<p style="Standard" xid="35">yes</p>
</cell>
<cell xid="36" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:1; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:0; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:3; top-attach:2">
<p style="Standard" xid="37">Rich Text</p>
</cell>
<cell xid="38" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:2; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:1; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:3; top-attach:2">
<p style="Standard" xid="39">yes</p>
</cell>
<cell xid="40" props="right-color:#000000; left-color:#000000; bot-style:solid; bot-thickness:0.5pt; right-attach:3; top-thickness:0.5pt; right-thickness:0.5pt; top-color:#000000; bot-color:#000000; left-attach:2; top-style:solid; right-style:solid; left-style:solid; left-thickness:0.5pt; bot-attach:3; top-attach:2">
