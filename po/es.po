#. Translators: the names of the looks Table AutoFormat offers, each
#. * with a line saying what it is.
#: src/model/w42-tableformat.c:16
msgid "Plain"
msgstr "Sencillo"

#: src/model/w42-tableformat.c:16
msgid "No rules and no shading."
msgstr "Sin líneas ni sombreado."

#: src/model/w42-tableformat.c:18
msgid "Grid"
msgstr "Cuadrícula"

#: src/model/w42-tableformat.c:18
msgid "Every cell ruled, the heading in bold."
msgstr "Todas las celdas con líneas y el título en negrita."

#: src/model/w42-tableformat.c:20
msgid "Ruled"
msgstr "Con líneas"

#: src/model/w42-tableformat.c:20
msgid "A rule round the table and under the heading."
msgstr "Una línea alrededor de la tabla y otra bajo el título."

#: src/model/w42-tableformat.c:22
msgid "Ruled Bands"
msgstr "Bandas con líneas"

#: src/model/w42-tableformat.c:22
msgid "Ruled, with every other row lightly shaded."
msgstr "Con líneas y filas alternas con un sombreado suave."

#: src/model/w42-tableformat.c:24
msgid "Shaded Heading"
msgstr "Título sombreado"

#: src/model/w42-tableformat.c:24
msgid "A grid, with the heading row shaded."
msgstr "Una cuadrícula con la fila de título sombreada."

#: src/model/w42-tableformat.c:26 src/ui/w42-dialogs.c:3258
msgid "Columns"
msgstr "Columnas"

#: src/model/w42-tableformat.c:26
msgid "A grid, heading and first column in bold."
msgstr "Una cuadrícula con el título y la primera columna en negrita."

#: src/model/w42-tableformat.c:28 src/model/w42-template.c:19
msgid "Report"
msgstr "Informe"

#: src/model/w42-tableformat.c:28
msgid "A rule round the table, the heading in bold italic."
msgstr "Una línea alrededor de la tabla y el título en negrita cursiva."

#: src/model/w42-template.c:15
msgid "Blank Document"
msgstr "Documento en blanco"

#: src/model/w42-template.c:15
msgid "An empty page, as File > New gives you."
msgstr "Una página vacía, como la que crea Archivo > Nuevo."

#: src/model/w42-template.c:16
msgid "Letter"
msgstr "Carta"

#: src/model/w42-template.c:16
msgid "A letter: the date, an address, a greeting and a closing."
msgstr "Una carta: la fecha, una dirección, un saludo y una despedida."

#: src/model/w42-template.c:17
msgid "Memo"
msgstr "Memorándum"

#: src/model/w42-template.c:17
msgid "A memorandum: To, From, Date and Subject over a rule."
msgstr "Un memorándum: Para, De, Fecha y Asunto sobre una línea."

#: src/model/w42-template.c:18
msgid "Fax Cover"
msgstr "Portada de fax"

#: src/model/w42-template.c:18
msgid "A fax cover sheet: who it is for, how many pages, a message."
msgstr "Una portada de fax: para quién es, cuántas páginas tiene y un mensaje."

#: src/model/w42-template.c:19
msgid "A report: a title, headings and a place for the text."
msgstr "Un informe: un título, títulos de sección y un espacio para el texto."

#: src/model/w42-template.c:20 src/model/w42-template.c:310
msgid "Meeting Notes"
msgstr "Acta de reunión"

#: src/model/w42-template.c:20
msgid "Notes of a meeting: who was there, what was decided."
msgstr "El acta de una reunión: quién asistió y qué se acordó."

#: src/model/w42-template.c:21
msgid "Novel"
msgstr "Novela"

#: src/model/w42-template.c:21
msgid ""
"A novel set as a book: small pages, justified text with indented paragraphs, "
"and every chapter on a page of its own."
msgstr ""
"Una novela compuesta como un libro: páginas pequeñas, texto justificado con "
"párrafos con sangría y cada capítulo en una página propia."

#: src/model/w42-template.c:23
msgid "Manuscript"
msgstr "Manuscrito"

#: src/model/w42-template.c:23
msgid ""
"A manuscript for an agent or a publisher: double-spaced, with your name and "
"the title at the top of every page."
msgstr ""
"Un manuscrito para un agente o una editorial: a doble espacio, con su nombre "
"y el título en la parte superior de cada página."

