#: src/ui/w42-window.c:4543
msgid "New"
msgstr "Nuevo"

#: src/ui/w42-window.c:4545
msgid "Save"
msgstr "Guardar"

#: src/ui/w42-window.c:4551
msgid "Cut"
msgstr "Cortar"

#: src/ui/w42-window.c:4552
msgid "Copy"
msgstr "Copiar"

#: src/ui/w42-window.c:4553
msgid "Paste"
msgstr "Pegar"

#: src/ui/w42-window.c:4555
msgid "Undo"
msgstr "Deshacer"

#: src/ui/w42-window.c:4556
msgid "Redo"
msgstr "Rehacer"

#: src/ui/w42-window.c:4559
msgid "Show as Slide Show"
msgstr "Mostrar como presentación"

#: src/ui/w42-window.c:4580
msgid "Zoom Control"
msgstr "Control de zoom"

#: src/ui/w42-window.c:4935
msgid "Font Color"
msgstr "Color de fuente"

#: src/ui/w42-window.c:5007
msgid "Align Left"
msgstr "Alinear a la izquierda"

#: src/ui/w42-window.c:5010
msgid "Align Right"
msgstr "Alinear a la derecha"

#: src/ui/w42-window.c:5010
msgid "Justify"
msgstr "Justificar"

#: src/ui/w42-window.c:5063
msgid "Font Size"
msgstr "Tamaño de fuente"

#: src/ui/w42-window.c:5070
msgid "Bold"
msgstr "Negrita"

#: src/ui/w42-window.c:5071
msgid "Italic"
msgstr "Cursiva"

#: src/ui/w42-window.c:5100
msgid "Bullets"
msgstr "Viñetas"

#. Translators: the status bar's page number.
#: src/ui/w42-window.c:5131 src/ui/w42-window.c:5967
#, c-format
msgid "Page %d"
msgstr "Pág. %d"

#. Translators: the status bar's reading of how far down the page
#. * the caret is, "At" short for "at so far from the top": %.1f is
#. * the distance, %s the unit, already translated (" or cm).
#: src/ui/w42-window.c:5133 src/ui/w42-window.c:5993
#, c-format
msgid "At %.1f%s"
msgstr "A %.1f%s"

#. Translators: the status bar's line number, "Ln" short for Line.
#: src/ui/w42-window.c:5135 src/ui/w42-window.c:5975
#, c-format
msgid "Ln %d"
msgstr "Lín. %d"

#. Translators: the status bar's column number, "Col" short for
#. * Column: how many characters in from the start of the line.
#: src/ui/w42-window.c:5137 src/ui/w42-window.c:5979
#, c-format
msgid "Col %d"
msgstr "Col. %d"

#. Translators: the status bar's word count toward the goal set in
#. * Tools > Word Count Goal: "12,000 of 80,000 words".  The first %s
#. * is the words written, the second the goal.
#: src/ui/w42-window.c:5240
#, c-format
msgid "%s of %s word"
msgid_plural "%s of %s words"
msgstr[0] "%s de %s palabra"
msgstr[1] "%s de %s palabras"

#. Translators: the status bar's word count; %s is the number, with
#. * thousands separators.
#: src/ui/w42-window.c:5248
#, c-format
msgid "%s word"
msgid_plural "%s words"
msgstr[0] "%s palabra"
msgstr[1] "%s palabras"

#. Translators: in the word count's tooltip; %d%% is how far
#. * toward the goal the document is, as "40%".
#: src/ui/w42-window.c:5259
#, c-format
msgid "%d%% of the goal."
msgstr "%d%% del objetivo."

#. Translators: in the word count's tooltip; %ld is the words
#. * written since the document was opened, which can be less than
#. * nothing when more was deleted.
#: src/ui/w42-window.c:5270
#, c-format
msgid "Written since the document was opened: %ld word."
msgid_plural "Written since the document was opened: %ld words."
msgstr[0] "Palabras escritas desde que se abrió el documento: %ld."
msgstr[1] "Palabras escritas desde que se abrió el documento: %ld."

#: src/ui/w42-window.c:5276
msgid "Tools ▸ Word Count Goal sets the goal."
msgstr "Herramientas ▸ Objetivo de palabras fija el objetivo."

#: src/ui/w42-window.c:5541
msgid "The rest are saved."
msgstr "Los demás se han guardado."

#: src/ui/w42-window.c:5541
msgid "Nothing was saved."
msgstr "No se guardó nada."

#: src/ui/w42-window.c:5542
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"Un documento que nunca se ha guardado, o que procede de un formato que "
"Word42 no vuelve a escribir, necesita un nombre: use Archivo > Guardar como."

#: src/ui/w42-window.c:5581 src/ui/w42-window.c:5623
msgid "Word42 could not read that file."
msgstr "Word42 no pudo leer ese archivo."

#: src/ui/w42-window.c:5617
msgid "The two documents are the same."
msgstr "Los dos documentos son iguales."

#: src/ui/w42-window.c:5619
#, c-format
msgid "%d change marked."
msgid_plural "%d changes marked."
msgstr[0] "Se marcó %d cambio."
msgstr[1] "Se marcaron %d cambios."

#: src/ui/w42-window.c:5643
msgid "Compare Documents: the original"
msgstr "Comparar documentos: el original"

#: src/ui/w42-window.c:5659
msgid "Insert File"
msgstr "Insertar archivo"

