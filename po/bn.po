msgstr "Word 97 নথি (*.doc)"

#: src/ui/w42-window.c:351
msgid "Word Document (*.docx)"
msgstr "Word নথি (*.docx)"

#: src/ui/w42-window.c:352
msgid "OpenDocument Text (*.odt)"
msgstr "OpenDocument পাঠ্য (*.odt)"

#: src/ui/w42-window.c:353
msgid "AbiWord (*.abw, *.zabw)"
msgstr "AbiWord নথি (*.abw, *.zabw)"

#: src/ui/w42-window.c:354
msgid "WordPerfect 6 (*.wpd)"
msgstr "WordPerfect 6 নথি (*.wpd)"

#: src/ui/w42-window.c:354
msgid "WordPerfect (*.wpd, *.wp)"
msgstr "WordPerfect নথি (*.wpd, *.wp)"

#: src/ui/w42-window.c:356
msgid "LaTeX (*.tex)"
msgstr "LaTeX নথি (*.tex)"

#: src/ui/w42-window.c:357 src/ui/w42-window.c:3019
msgid "Web Pages (*.html)"
msgstr "ওয়েব পৃষ্ঠা (*.html)"

#: src/ui/w42-window.c:358 src/ui/w42-window.c:3160
msgid "Presentations (*.pptx)"
msgstr "উপস্থাপনা (*.pptx)"

#: src/ui/w42-window.c:359
msgid "Text Documents (*.txt)"
msgstr "পাঠ্য নথি (*.txt)"

#: src/ui/w42-window.c:362
msgid "All Files"
msgstr "সব ফাইল"

#. Translators: the name of the copy Tools > Options > Always create
#. * backup copy keeps beside a file; %s is the file's own name.  It is a
#. * file name: no slashes, backslashes or colons, and %s last, so that the
#. * copy keeps the file's extension and opens as the file does.
#: src/ui/w42-window.c:629
#, c-format
msgid "Backup of %s"
msgstr "ব্যাকআপ - %s"

#. Translators: %s is the recovered document's name.
#: src/ui/w42-window.c:703
#, c-format
msgid "Word42 recovered “%s”."
msgstr "Word42 “%s” পুনরুদ্ধার করেছে।"

#: src/ui/w42-window.c:706
msgid ""
"It was not saved when Word42 last stopped. Save it to keep it; close it to "
"let it go."
msgstr ""
"Word42 শেষবার বন্ধ হওয়ার সময় এটি সংরক্ষিত ছিল না। রাখতে চাইলে সংরক্ষণ করুন; বাদ "
"দিতে চাইলে বন্ধ করুন।"

#. Translators: %d is how many autosaved copies could not be read,
#. * %s the folder they are kept in.
#: src/ui/w42-window.c:751
#, c-format
msgid ""
"%d document left when Word42 last stopped could not be read. It is kept in "
"%s, with names ending .bad."
msgid_plural ""
"%d documents left when Word42 last stopped could not be read. They are kept "
"in %s, with names ending .bad."
msgstr[0] ""
"Word42 শেষবার বন্ধ হওয়ার সময় রয়ে যাওয়া %dটি নথি পড়া যায়নি। সেটি %s-এ রাখা "
"আছে, নামের শেষে .bad সহ।"
msgstr[1] ""
"Word42 শেষবার বন্ধ হওয়ার সময় রয়ে যাওয়া %dটি নথি পড়া যায়নি। সেগুলি %s-এ রাখা "
"আছে, নামের শেষে .bad সহ।"

#: src/ui/w42-window.c:761
msgid "Word42 could not recover everything."
msgstr "Word42 সবকিছু পুনরুদ্ধার করতে পারেনি।"

#: src/ui/w42-window.c:978 src/ui/w42-window.c:1235 src/ui/w42-window.c:1253
#: src/ui/w42-window.c:1352 src/ui/w42-window.c:5773
msgid "Word42 could not open that file."
msgstr "Word42 ফাইলটি খুলতে পারেনি।"

#. Translators: %s is the file's name.
#: src/ui/w42-window.c:1109
#, c-format
msgid "“%s” is protected with a password."
msgstr "“%s” পাসওয়ার্ড দিয়ে সুরক্ষিত।"

#: src/ui/w42-window.c:1112
msgid ""
"The password is not correct. Passwords tell capital letters from small ones."
msgstr "পাসওয়ার্ডটি সঠিক নয়। পাসওয়ার্ডে বড় ও ছোট হাতের অক্ষর আলাদা ধরা হয়।"

#: src/ui/w42-window.c:1114 src/ui/w42-window.c:1151
msgid "_Password:"
msgstr "পাসওয়ার্ড(_P):"

#: src/ui/w42-window.c:1141
msgid "_Read Only"
msgstr "শুধুমাত্র পঠনযোগ্য(_R)"

#. Translators: %s is the file's name.
#: src/ui/w42-window.c:1144
#, c-format
msgid "“%s” is reserved: it allows no changes without its password to modify."
msgstr "“%s” সংরক্ষিত: এর পরিবর্তনের পাসওয়ার্ড ছাড়া কোনো পরিবর্তন করা যায় না।"

#: src/ui/w42-window.c:1148
msgid ""
"That is not its password to modify. Enter the password, or open the PDF read "
"only."
msgstr ""
"এটি এর পরিবর্তনের পাসওয়ার্ড নয়। পাসওয়ার্ডটি লিখুন, অথবা PDF-টি শুধুমাত্র পঠনযোগ্য "
"হিসাবে খুলুন।"

#: src/ui/w42-window.c:1150
msgid "Enter the password to modify it, or open it read only."
msgstr "এটি পরিবর্তন করতে পাসওয়ার্ড লিখুন, অথবা শুধুমাত্র পঠনযোগ্য হিসাবে খুলুন।"

#. Translators: the title of a document opened read only; %s is its
#. * name.
#: src/ui/w42-window.c:1171
#, c-format
msgid "%s (Read-Only)"
msgstr "%s (শুধুমাত্র পঠনযোগ্য)"

#: src/ui/w42-window.c:1177
msgid "Opened read only. File ▸ Save As saves it under a name of its own."
msgstr ""
"শুধুমাত্র পঠনযোগ্য হিসাবে খোলা হয়েছে। ফাইল ▸ এই হিসাবে সংরক্ষণ করুন এটিকে নিজস্ব "
"নামে সংরক্ষণ করে।"

#: src/ui/w42-window.c:1194
msgid ""
"This PDF is signed. Saved again it is a new file, which the signature does "
"not cover: File ▸ PDF Options signs it anew."
msgstr ""
"এই PDF-এ স্বাক্ষর আছে। আবার সংরক্ষণ করলে এটি একটি নতুন ফাইল, যা স্বাক্ষরের আওতায় "
"পড়ে না: ফাইল ▸ PDF বিকল্প এতে নতুন করে স্বাক্ষর করে।"

#: src/ui/w42-window.c:1198
msgid ""
"Another program has changed this PDF since Word42 saved it. What is open is "
"the document as Word42 saved it."
msgstr ""
"Word42 সংরক্ষণ করার পর অন্য একটি প্রোগ্রাম এই PDF পরিবর্তন করেছে। যা খোলা আছে তা "
"Word42 যেমন সংরক্ষণ করেছিল তেমন নথি।"

#: src/ui/w42-window.c:1201
msgid ""
"Word42 read this PDF from its pages. Saving it writes the pages again, with "
"the document inside for next time."
msgstr ""
"Word42 এই PDF এর পৃষ্ঠাগুলি থেকে পড়েছে। সংরক্ষণ করলে পৃষ্ঠাগুলি আবার লেখা হয়, পরের "
"বারের জন্য ভিতরে নথিসহ।"

#. Translators: %s is the name of the file exported to.
#: src/ui/w42-window.c:1302
#, c-format
msgid ""
"Exported as %s. The document itself is not saved there: Word42 cannot read "
"that format back as it was."
msgstr ""
"%s হিসাবে রপ্তানি করা হয়েছে। নথিটি নিজে সেখানে সংরক্ষিত হয়নি: Word42 ওই ফরম্যাট "
"থেকে নথিটি আগের মতো করে পড়তে পারে না।"

#: src/ui/w42-window.c:1394
msgid ""
"This document has not been saved yet, so there is nothing to go back to."
msgstr "এই নথিটি এখনও সংরক্ষণ করা হয়নি, তাই ফিরে যাওয়ার মতো কিছু নেই।"

#: src/ui/w42-window.c:1400
msgid "The document has no unsaved changes."
msgstr "নথিটিতে কোনো অসংরক্ষিত পরিবর্তন নেই।"

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1406
#, c-format
msgid "Revert “%s” to the saved version?"
msgstr "“%s” কি সংরক্ষিত সংস্করণে ফিরিয়ে নেবেন?"

#: src/ui/w42-window.c:1408
msgid "The changes made since the document was last saved will be lost."
msgstr "নথিটি শেষবার সংরক্ষণের পর থেকে করা পরিবর্তনগুলি হারিয়ে যাবে।"

#: src/ui/w42-window.c:1462
msgid "Word42 saved the document but could not keep it as a version."
msgstr "Word42 নথিটি সংরক্ষণ করেছে কিন্তু এটিকে সংস্করণ হিসাবে রাখতে পারেনি।"

#. Translators: %s is what Git said went wrong.
#: src/ui/w42-window.c:1466
#, c-format
msgid "Saved, but Git could not keep it as a version: %s"
msgstr "সংরক্ষিত হয়েছে, কিন্তু Git এটিকে সংস্করণ হিসাবে রাখতে পারেনি: %s"

#. Translators: %s is a file name.
#: src/ui/w42-window.c:1572
#, c-format
msgid "“%s” already exists. Replace it?"
msgstr "“%s” ইতিমধ্যে বিদ্যমান। এটি প্রতিস্থাপন করবেন?"

#: src/ui/w42-window.c:1579
msgid "The file that is there now will be lost."
msgstr "এখন যে ফাইলটি আছে সেটি হারিয়ে যাবে।"

#: src/ui/w42-window.c:1600 src/ui/w42-window.c:1606 src/ui/w42-window.c:1628
#: src/ui/w42-window.c:1758 src/ui/w42-window.c:1784 src/ui/w42-window.c:5679
msgid "Word42 could not save that file."
msgstr "Word42 ফাইলটি সংরক্ষণ করতে পারেনি।"

#: src/ui/w42-window.c:1645
msgid "Save As"
msgstr "এই হিসাবে সংরক্ষণ করুন"

#. Translators: %s is the PDF's file name.
#: src/ui/w42-window.c:1728
#, c-format
msgid "Replace “%s” with Word42's pages?"
msgstr "“%s” কি Word42-এর পৃষ্ঠা দিয়ে প্রতিস্থাপন করবেন?"

#: src/ui/w42-window.c:1731
msgid ""
"Word42 read this PDF from its pages, not from a document of its own. Saved, "
"the PDF is laid out again by Word42, with the document inside it so that it "
"opens as it is now; the pages it has now are not kept."
msgstr ""
"Word42 এই PDF এর পৃষ্ঠাগুলি থেকে পড়েছে, নিজের কোনো নথি থেকে নয়। সংরক্ষণ করলে "
"Word42 PDF-টি নতুন করে সাজায়, ভিতরে নথিসহ যাতে এটি এখন যেমন আছে তেমনই খোলে; "
"এখনকার পৃষ্ঠাগুলি রাখা হয় না।"

#: src/ui/w42-window.c:1835 src/ui/w42-window.c:1853
msgid "Word42 could not save that template."
msgstr "Word42 টেমপ্লেটটি সংরক্ষণ করতে পারেনি।"

#: src/ui/w42-window.c:1837
msgid "Saved as a template.  File > New from Template lists it."
msgstr ""
"টেমপ্লেট হিসাবে সংরক্ষিত হয়েছে।  ফাইল > টেমপ্লেট থেকে নতুন-এর তালিকায় এটি দেখা "
"যাবে।"

#: src/ui/w42-window.c:1878
msgid "Save as Template"
msgstr "টেমপ্লেট হিসাবে সংরক্ষণ করুন"

#: src/ui/w42-window.c:1937
msgid "Don't Save"
msgstr "সংরক্ষণ করবেন না"

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1950
#, c-format
msgid "Save changes to “%s”?"
msgstr "“%s”-এ করা পরিবর্তনগুলি সংরক্ষণ করবেন?"

#: src/ui/w42-window.c:1953
msgid "If you close without saving, the changes you have made will be lost."
msgstr "সংরক্ষণ না করে বন্ধ করলে আপনার করা পরিবর্তনগুলি হারিয়ে যাবে।"

#: src/ui/w42-window.c:2654 src/ui/w42-window.c:5192
msgid "Font"
msgstr "ফন্ট"

#: src/ui/w42-window.c:2724
msgid "Word42 could not insert that picture."
msgstr "Word42 ছবিটি সন্নিবেশ করতে পারেনি।"

#: src/ui/w42-window.c:2732
msgid "Word42 could not open that picture."
msgstr "Word42 ছবিটি খুলতে পারেনি।"

#: src/ui/w42-window.c:2752
msgid "Pictures"
msgstr "ছবি"

#: src/ui/w42-window.c:2756 src/ui/w42-window.c:4702
msgid "Insert Picture"
msgstr "ছবি সন্নিবেশ করুন"

#: src/ui/w42-window.c:2778
msgid "No scanner can be reached from here."
msgstr "এখান থেকে কোনো স্ক্যানারে পৌঁছানো যাচ্ছে না।"

#: src/ui/w42-window.c:2779
msgid ""
"Word42 scans through Windows Image Acquisition on Windows and through SANE's "
"scanimage on Linux; neither was found."
msgstr ""
"Word42 Windows-এ Windows Image Acquisition এবং Linux-এ SANE-এর scanimage "
"দিয়ে স্ক্যান করে; কোনোটিই পাওয়া যায়নি।"

#: src/ui/w42-window.c:2792
msgid "The scanner sent a picture Word42 cannot read."
msgstr "স্ক্যানার এমন একটি ছবি পাঠিয়েছে যা Word42 পড়তে পারে না।"

#: src/ui/w42-window.c:2796
msgid "Word42 could not scan."
msgstr "Word42 স্ক্যান করতে পারেনি।"

#: src/ui/w42-window.c:2829 src/ui/w42-window.c:2838
msgid "Word42 could not export the PDF."
msgstr "Word42 PDF রপ্তানি করতে পারেনি।"

#: src/ui/w42-window.c:2862 src/ui/w42-window.c:2867
msgid "Word42 could not export the web page."
msgstr "Word42 ওয়েব পৃষ্ঠা রপ্তানি করতে পারেনি।"

#: src/ui/w42-window.c:2892
msgid "LaTeX mode: Export as PDF typesets with LaTeX."
msgstr "LaTeX মোড: “PDF হিসাবে রপ্তানি করুন” LaTeX দিয়ে টাইপসেট করে।"

#: src/ui/w42-window.c:2894
msgid "LaTeX mode is on, but no TeX engine is installed."
msgstr "LaTeX মোড চালু আছে, কিন্তু কোনো TeX ইঞ্জিন ইনস্টল করা নেই।"

#: src/ui/w42-window.c:2895
msgid ""
"Install Tectonic (tectonic-typesetting.github.io), which fetches what it "
"needs by itself, or MiKTeX (miktex.org) or TeX Live (tug.org/texlive). Until "
"then, File > Save As can still write the document as LaTeX (.tex)."
msgstr ""
"Tectonic (tectonic-typesetting.github.io) ইনস্টল করুন, যা প্রয়োজনীয় সবকিছু নিজেই "
"নামিয়ে নেয়, অথবা MiKTeX (miktex.org) বা TeX Live (tug.org/texlive) ইনস্টল "
"করুন। ততক্ষণ পর্যন্ত ফাইল > এই হিসাবে সংরক্ষণ করুন দিয়ে নথিটি LaTeX (.tex) হিসাবে "
"লেখা যায়।"

#: src/ui/w42-window.c:2901
msgid "LaTeX mode is off: Word42 makes the PDFs itself."
msgstr "LaTeX মোড বন্ধ আছে: Word42 নিজেই PDF তৈরি করে।"

#: src/ui/w42-window.c:2995
msgid "Word42 could not write the web page to preview."
msgstr "Word42 পূর্বরূপ দেখানোর জন্য ওয়েব পৃষ্ঠাটি লিখতে পারেনি।"

#: src/ui/w42-window.c:3020
msgid "Export as Web Page"
msgstr "ওয়েব পৃষ্ঠা হিসাবে রপ্তানি করুন"

#: src/ui/w42-window.c:3051 src/ui/w42-window.c:3058
msgid "Word42 could not export the e-book."
msgstr "Word42 ই-বুক রপ্তানি করতে পারেনি।"

#: src/ui/w42-window.c:3053
msgid "The e-book is written."
msgstr "ই-বুকটি লেখা হয়েছে।"

#: src/ui/w42-window.c:3081
msgid "E-books (*.epub)"
msgstr "ই-বুক (*.epub)"

#: src/ui/w42-window.c:3082
msgid "Export as E-book"
msgstr "ই-বুক হিসাবে রপ্তানি করুন"

#: src/ui/w42-window.c:3110 src/ui/w42-window.c:3115
msgid "Word42 could not export the presentation."
msgstr "Word42 উপস্থাপনাটি রপ্তানি করতে পারেনি।"

#: src/ui/w42-window.c:3142
msgid "There is nothing to make slides of."
msgstr "স্লাইড তৈরি করার মতো কিছু নেই।"

#: src/ui/w42-window.c:3143
msgid ""
"A slide is a heading and the lines under it: give the document's headings "
"the Heading 1 style, or a Title."
msgstr ""
"একটি স্লাইড হলো একটি শিরোনাম ও তার নিচের লাইনগুলি: নথির শিরোনামগুলিতে Heading 1 "
"শৈলী, অথবা Title শৈলী দিন।"

#: src/ui/w42-window.c:3148
#, c-format
msgid "%u slide."
msgid_plural "%u slides."
msgstr[0] "%uটি স্লাইড।"
msgstr[1] "%uটি স্লাইড।"

#: src/ui/w42-window.c:3161
msgid "Export as Presentation"
msgstr "উপস্থাপনা হিসাবে রপ্তানি করুন"

#: src/ui/w42-window.c:3193
msgid "Export as PDF"
msgstr "PDF হিসাবে রপ্তানি করুন"

#: src/ui/w42-window.c:3402
msgid "The caret is in the first row: there is nothing above it to split off."
msgstr "কার্সার প্রথম সারিতে আছে: এর উপরে আলাদা করার মতো কিছু নেই।"

#: src/ui/w42-window.c:3430
msgid "There is nothing to convert here."
msgstr "এখানে রূপান্তর করার মতো কিছু নেই।"

#: src/ui/w42-window.c:3431
msgid ""
"In a table this makes paragraphs with tabs between the cells; on selected "
"paragraphs it makes a table, split at their tabs."
msgstr ""
"সারণীর ভিতরে এটি কক্ষগুলির মাঝে ট্যাবসহ অনুচ্ছেদ তৈরি করে; নির্বাচিত অনুচ্ছেদে এটি "
"ট্যাবের জায়গায় ভাগ করে একটি সারণী তৈরি করে।"

#: src/ui/w42-window.c:3479 src/ui/w42-window.c:3499 src/ui/w42-window.c:3521
#: src/ui/w42-window.c:3947 src/ui/w42-window.c:3963 src/ui/w42-window.c:4187
msgid "The caret is in a note: put it in the body of the document first."
msgstr "কার্সার একটি টীকার ভিতরে আছে: প্রথমে এটি নথির মূল অংশে রাখুন।"

#: src/ui/w42-window.c:3485
msgid "There is nothing marked for the index."
msgstr "সূচির জন্য কিছুই চিহ্নিত করা নেই।"

#: src/ui/w42-window.c:3486
msgid ""
"Select a word and use Insert ▸ Index Entry to mark it, then ask for the "
"index again."
msgstr ""
"একটি শব্দ নির্বাচন করে সন্নিবেশ ▸ সূচি ভুক্তি দিয়ে তা চিহ্নিত করুন, তারপর আবার সূচি "
"তৈরি করুন।"

#: src/ui/w42-window.c:3505
msgid "There are no captions to list."
msgstr "তালিকাভুক্ত করার মতো কোনো ক্যাপশন নেই।"

#: src/ui/w42-window.c:3506
msgid ""
"Insert ▸ Caption puts a caption under a picture, and the table of figures "
"lists them."
msgstr ""
"সন্নিবেশ ▸ ক্যাপশন একটি ছবির নিচে ক্যাপশন বসায়, এবং চিত্রের সারণী সেগুলির তালিকা "
"দেয়।"

#: src/ui/w42-window.c:3527
msgid "There are no headings to list."
msgstr "তালিকাভুক্ত করার মতো কোনো শিরোনাম নেই।"

#: src/ui/w42-window.c:3528
msgid "Give the document's headings the Heading 1, 2 or 3 style and try again."
msgstr "নথির শিরোনামগুলিতে Heading 1, 2 বা 3 শৈলী দিন এবং আবার চেষ্টা করুন।"

#: src/ui/w42-window.c:3575
msgid "There is no table of contents to update."
msgstr "হালনাগাদ করার মতো কোনো সূচিপত্র নেই।"

#: src/ui/w42-window.c:3576
msgid "Insert > Table of Contents puts one in."
msgstr "সন্নিবেশ > সূচিপত্র দিয়ে একটি যোগ করুন।"

#: src/ui/w42-window.c:3612
msgid "No hyphenation dictionary was found."
msgstr "কোনো হাইফেনেশন অভিধান পাওয়া যায়নি।"

#: src/ui/w42-window.c:3613
msgid ""
"Hyphenation needs libhyphen and a hyph_*.dic pattern file for your language, "
"the ones LibreOffice uses."
msgstr ""
"হাইফেনেশনের জন্য libhyphen এবং আপনার ভাষার একটি hyph_*.dic প্যাটার্ন ফাইল "
"প্রয়োজন, যেগুলি LibreOffice ব্যবহার করে।"

#: src/ui/w42-window.c:3616
msgid "There is nothing to hyphenate."
msgstr "হাইফেন যোগ করার মতো কিছু নেই।"

#: src/ui/w42-window.c:3628
#, c-format
msgid "%d hyphen removed."
msgid_plural "%d hyphens removed."
msgstr[0] "%dটি হাইফেন সরানো হয়েছে।"
msgstr[1] "%dটি হাইফেন সরানো হয়েছে।"

#: src/ui/w42-window.c:3631
msgid "There are no soft hyphens to remove."
msgstr "সরানোর মতো কোনো সফট হাইফেন নেই।"

#: src/ui/w42-window.c:3784
msgid ""
"Type the name of an AutoText entry, then press Ctrl+F3.  Edit > AutoText "
"makes one from the selection."
msgstr ""
"একটি স্বতঃপাঠ্য ভুক্তির নাম টাইপ করুন, তারপর Ctrl+F3 চাপুন।  সম্পাদনা > স্বতঃপাঠ্য "
"নির্বাচিত অংশ থেকে একটি ভুক্তি তৈরি করে।"

#: src/ui/w42-window.c:3825
#, c-format
msgid "%d field updated."
msgid_plural "%d fields updated."
msgstr[0] "%dটি ক্ষেত্র হালনাগাদ করা হয়েছে।"
msgstr[1] "%dটি ক্ষেত্র হালনাগাদ করা হয়েছে।"

#: src/ui/w42-window.c:3828
msgid "There are no fields in this document."
msgstr "এই নথিতে কোনো ক্ষেত্র নেই।"

#. Translators: the label Insert > Caption puts in the document; %d is
#. * the figure's number.  Keep a word before the number, and keep %d as
#. * it is: the captions already there are counted by what comes before
#. * it.
#: src/ui/w42-window.c:3898 src/ui/w42-window.c:3914
#, c-format
msgid "Figure %d: "
msgstr "চিত্র %d: "

#: src/ui/w42-window.c:3977
msgid "Put the caret at a note's mark, or in the note itself."
msgstr "কার্সারটি টীকার চিহ্নে, অথবা টীকার ভিতরে রাখুন।"

#: src/ui/w42-window.c:4059
msgid "No thesaurus was found."
msgstr "কোনো সমার্থশব্দকোষ পাওয়া যায়নি।"

#: src/ui/w42-window.c:4060
msgid ""
"The thesaurus needs a MyThes file for the language of the text -- "
"th_en_US_v2.dat and its .idx for English, th_nb_NO_v2 for Norwegian, the "
"ones LibreOffice uses -- in the mythes folder."
msgstr ""
"সমার্থশব্দকোষের জন্য mythes ফোল্ডারে পাঠ্যের ভাষার একটি MyThes ফাইল প্রয়োজন -- "
"ইংরেজির জন্য th_en_US_v2.dat ও তার .idx, নরওয়েজিয়ানের জন্য th_nb_NO_v2, যেগুলি "
"LibreOffice ব্যবহার করে।"

#: src/ui/w42-window.c:4067
msgid "Put the caret in a word to look it up in the thesaurus."
msgstr "সমার্থশব্দকোষে খুঁজতে কার্সারটি একটি শব্দের ভিতরে রাখুন।"

#: src/ui/w42-window.c:4079
msgid "No spelling dictionary was found."
msgstr "কোনো বানান অভিধান পাওয়া যায়নি।"

#: src/ui/w42-window.c:4080
msgid "Install a Hunspell dictionary for your language and start Word42 again."
msgstr ""
"আপনার ভাষার জন্য একটি Hunspell অভিধান ইনস্টল করুন এবং Word42 আবার চালু করুন।"

#: src/ui/w42-window.c:4133
msgid "Revisions accepted."
msgstr "সংশোধনগুলি গৃহীত হয়েছে।"

#: src/ui/w42-window.c:4135 src/ui/w42-window.c:4147
msgid "There are no revision marks in this document."
msgstr "এই নথিতে কোনো সংশোধন চিহ্ন নেই।"

#: src/ui/w42-window.c:4145
msgid "Revisions rejected."
msgstr "সংশোধনগুলি প্রত্যাখ্যাত হয়েছে।"

#. Translators: the Windows version in the About box, as "Windows
#. * 10.0 build 19045 (Windows 10)": the major and minor version, the
#. * build number, then the release's name in brackets or nothing.
#: src/ui/w42-window.c:4258
#, c-format
msgid "Windows %lu.%lu build %lu%s"
msgstr "Windows %lu.%lu বিল্ড %lu%s"

#. Translators: what the About box says this copy runs on, for bug
#. * reports.  The version numbers and library names fill the
#. * placeholders in turn: Word42's version; GTK's running version and
#. * the one built against; GLib's; Pango's, Cairo's and GdkPixbuf's;
#. * the operating system; then the spelling, hyphenation and PDF
#. * import libraries, or "none".
#: src/ui/w42-window.c:4289
#, c-format
msgid ""
"Word42 %s\n"
"GTK %u.%u.%u (built against %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"Spelling: %s  ·  Hyphenation: %s  ·  PDF import: %s"
msgstr ""
"Word42 %s\n"
"GTK %u.%u.%u (%d.%d.%d-এর সাথে বিল্ড করা)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"বানান: %s  ·  হাইফেনেশন: %s  ·  PDF আমদানি: %s"

#. Translators: no library for this, in the About box.
#: src/ui/w42-window.c:4304 src/ui/w42-window.c:4310 src/ui/w42-window.c:4316
msgctxt "library"
msgid "none"
msgstr "নেই"

#: src/ui/w42-window.c:4348
msgid "About Word42"
msgstr "Word42 সম্পর্কে"

#. Translators: %s is Word42's version number.
#: src/ui/w42-window.c:4371
#, c-format
msgid "Version %s"
msgstr "সংস্করণ %s"

#: src/ui/w42-window.c:4382
msgid "Written in C on GTK 4, Pango and Cairo."
msgstr "GTK 4, Pango ও Cairo ভিত্তিক, C ভাষায় লেখা।"

