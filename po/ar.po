#. Translators: OLE is the container a Word 97 file is kept in,
#. * made of numbered sectors; %u is a sector's number.
#: src/io/w42-doc.c:131
#, c-format
msgid "OLE sector %u is past the end of the file"
msgstr "قطاع OLE رقم %u يقع بعد نهاية الملف"

#. Translators: OLE is the container a Word 97 file is kept in,
#. * FAT its table of sectors; %u is a sector's number.
#: src/io/w42-doc.c:135
#, c-format
msgid "OLE sector %u has no FAT entry"
msgstr "قطاع OLE رقم %u ليس له إدخال في FAT"

#: src/io/w42-doc.c:137
msgid "OLE sector chain loops"
msgstr "سلسلة قطاعات OLE تدور في حلقة مغلقة"

