msgstr "Un filet autour du tableau et sous l'en-tête."

#: src/model/w42-tableformat.c:22
msgid "Ruled Bands"
msgstr "Filets et bandes"

#: src/model/w42-tableformat.c:22
msgid "Ruled, with every other row lightly shaded."
msgstr "Des filets, avec une ligne sur deux légèrement tramée."

#: src/model/w42-tableformat.c:24
msgid "Shaded Heading"
msgstr "En-tête tramé"

#: src/model/w42-tableformat.c:24
