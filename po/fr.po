#: src/ui/w42-window.c:4394 src/ui/w42-window.c:5217
#, c-format
msgid "Page %d"
msgstr "Page %d"

#. Translators: the status bar's reading of how far down the page
#. * the caret is, "At" short for "at so far from the top": %.1f is
#. * the distance, %s the unit, already translated (" or cm).
#: src/ui/w42-window.c:4396 src/ui/w42-window.c:5243
#, c-format
msgid "At %.1f%s"
msgstr "À %.1f%s"

#. Translators: the status bar's line number, "Ln" short for Line.
#: src/ui/w42-window.c:4398 src/ui/w42-window.c:5225
#, c-format
msgid "Ln %d"
msgstr "Li %d"

#. Translators: the status bar's column number, "Col" short for
#. * Column: how many characters in from the start of the line.
#: src/ui/w42-window.c:4400 src/ui/w42-window.c:5229
#, c-format
msgid "Col %d"
msgstr "Col %d"

#. Translators: the status bar's word count toward the goal set in
#. * Tools > Word Count Goal: "12,000 of 80,000 words".  The first %s
#. * is the words written, the second the goal.
#: src/ui/w42-window.c:4503
#, c-format
msgid "%s of %s word"
msgid_plural "%s of %s words"
msgstr[0] "%s sur %s mot"
msgstr[1] "%s sur %s mots"

#. Translators: the status bar's word count; %s is the number, with
#. * thousands separators.
#: src/ui/w42-window.c:4511
#, c-format
msgid "%s word"
msgid_plural "%s words"
msgstr[0] "%s mot"
msgstr[1] "%s mots"

#. Translators: in the word count's tooltip; %d%% is how far
#. * toward the goal the document is, as "40%".
#: src/ui/w42-window.c:4522
#, c-format
msgid "%d%% of the goal."
msgstr "%d %% de l'objectif."

#. Translators: in the word count's tooltip; %ld is the words
#. * written since the document was opened, which can be less than
#. * nothing when more was deleted.
#: src/ui/w42-window.c:4533
#, c-format
msgid "Written since the document was opened: %ld word."
msgid_plural "Written since the document was opened: %ld words."
msgstr[0] "Écrit depuis l'ouverture du document : %ld mot."
msgstr[1] "Écrits depuis l'ouverture du document : %ld mots."

#: src/ui/w42-window.c:4539
msgid "Tools ▸ Word Count Goal sets the goal."
msgstr "Outils ▸ Objectif de nombre de mots définit l'objectif."

#: src/ui/w42-window.c:4791
msgid "The rest are saved."
msgstr "Les autres sont enregistrés."

#: src/ui/w42-window.c:4791
msgid "Nothing was saved."
msgstr "Rien n'a été enregistré."

#: src/ui/w42-window.c:4792
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"Un document qui n'a jamais été enregistré, ou qui provient d'un format que "
"Word42 ne réécrit pas, a besoin d'un nom : utilisez Fichier > Enregistrer "
"sous."

#: src/ui/w42-window.c:4831 src/ui/w42-window.c:4873
msgid "Word42 could not read that file."
msgstr "Word42 n'a pas pu lire ce fichier."

#: src/ui/w42-window.c:4867
msgid "The two documents are the same."
msgstr "Les deux documents sont identiques."

#: src/ui/w42-window.c:4869
#, c-format
msgid "%d change marked."
msgid_plural "%d changes marked."
msgstr[0] "%d modification marquée."
msgstr[1] "%d modifications marquées."

#: src/ui/w42-window.c:4893
msgid "Compare Documents: the original"
msgstr "Comparer les documents : l'original"

#: src/ui/w42-window.c:4909
