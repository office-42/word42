#. Translators: the name of the copy Tools > Options > Always create
#. * backup copy keeps beside a file; %s is the file's own name.  It is a
#. * file name: no slashes, backslashes or colons, and %s last, so that the
#. * copy keeps the file's extension and opens as the file does.
#: src/ui/w42-window.c:616
#, c-format
msgid "Backup of %s"
msgstr "بیک اپ برائے %s"

#. Translators: %s is the recovered document's name.
#: src/ui/w42-window.c:690
#, c-format
msgid "Word42 recovered “%s”."
msgstr "Word42 نے “%s” بازیاب کر لی۔"

#: src/ui/w42-window.c:693
msgid ""
"It was not saved when Word42 last stopped. Save it to keep it; close it to "
"let it go."
msgstr ""
"جب Word42 آخری بار بند ہوا تو یہ محفوظ نہیں کی گئی تھی۔ اسے رکھنے کے لیے "
"محفوظ کریں؛ چھوڑنے کے لیے بند کر دیں۔"

#. Translators: %d is how many autosaved copies could not be read,
#. * %s the folder they are kept in.
#: src/ui/w42-window.c:738
#, c-format
msgid ""
"%d document left when Word42 last stopped could not be read. It is kept in "
"%s, with names ending .bad."
msgid_plural ""
"%d documents left when Word42 last stopped could not be read. They are kept "
"in %s, with names ending .bad."
msgstr[0] ""
"Word42 کے آخری بار بند ہونے پر رہ جانے والی %d دستاویز پڑھی نہیں جا سکی۔ اسے "
"%s میں ایسے نام کے ساتھ رکھا گیا ہے جو .bad پر ختم ہوتا ہے۔"
msgstr[1] ""
"Word42 کے آخری بار بند ہونے پر رہ جانے والی %d دستاویزات پڑھی نہیں جا سکیں۔ "
"انہیں %s میں ایسے ناموں کے ساتھ رکھا گیا ہے جو .bad پر ختم ہوتے ہیں۔"

#: src/ui/w42-window.c:748
msgid "Word42 could not recover everything."
msgstr "Word42 سب کچھ بازیاب نہیں کر سکا۔"

#: src/ui/w42-window.c:965 src/ui/w42-window.c:1222 src/ui/w42-window.c:1240
#: src/ui/w42-window.c:1339 src/ui/w42-window.c:5629
msgid "Word42 could not open that file."
msgstr "Word42 وہ فائل نہیں کھول سکا۔"

#. Translators: %s is the file's name.
#: src/ui/w42-window.c:1096
#, c-format
msgid "“%s” is protected with a password."
msgstr "“%s” پاس ورڈ سے محفوظ ہے۔"

#: src/ui/w42-window.c:1099
msgid ""
"The password is not correct. Passwords tell capital letters from small ones."
msgstr ""
"پاس ورڈ درست نہیں ہے۔ پاس ورڈ میں بڑے اور چھوٹے حروف الگ سمجھے جاتے ہیں۔"

#: src/ui/w42-window.c:1101 src/ui/w42-window.c:1138
msgid "_Password:"
msgstr "_پاس ورڈ:"

#: src/ui/w42-window.c:1128
msgid "_Read Only"
msgstr "_صرف پڑھنے کے لیے"

#. Translators: %s is the file's name.
#: src/ui/w42-window.c:1131
#, c-format
msgid "“%s” is reserved: it allows no changes without its password to modify."
msgstr ""
"“%s” مخصوص ہے: اس کے ترمیم کے پاس ورڈ کے بغیر کوئی تبدیلی نہیں ہو سکتی۔"

#: src/ui/w42-window.c:1135
msgid ""
"That is not its password to modify. Enter the password, or open the PDF read "
"only."
msgstr ""
"یہ اس کا ترمیم کا پاس ورڈ نہیں ہے۔ پاس ورڈ درج کریں، یا PDF کو صرف پڑھنے کے "
"لیے کھولیں۔"

#: src/ui/w42-window.c:1137
msgid "Enter the password to modify it, or open it read only."
msgstr "اس میں ترمیم کے لیے پاس ورڈ درج کریں، یا اسے صرف پڑھنے کے لیے کھولیں۔"

#. Translators: the title of a document opened read only; %s is its
#. * name.
#: src/ui/w42-window.c:1158
#, c-format
msgid "%s (Read-Only)"
msgstr "%s (صرف پڑھنے کے لیے)"

#: src/ui/w42-window.c:1164
msgid "Opened read only. File ▸ Save As saves it under a name of its own."
msgstr ""
"صرف پڑھنے کے لیے کھولی گئی۔ فائل ▸ بطور محفوظ کریں اسے اس کے اپنے نام سے "
"محفوظ کرتا ہے۔"

#: src/ui/w42-window.c:1181
msgid ""
"This PDF is signed. Saved again it is a new file, which the signature does "
"not cover: File ▸ PDF Options signs it anew."
msgstr ""
"اس PDF پر دستخط ہیں۔ دوبارہ محفوظ کرنے پر یہ ایک نئی فائل ہے جس پر دستخط "
"لاگو نہیں ہوتے: فائل ▸ PDF اختیارات اس پر نئے سرے سے دستخط کرتا ہے۔"

#: src/ui/w42-window.c:1185
msgid ""
"Another program has changed this PDF since Word42 saved it. What is open is "
"the document as Word42 saved it."
msgstr ""
"Word42 کے محفوظ کرنے کے بعد کسی اور پروگرام نے اس PDF کو بدلا ہے۔ جو کھلی ہے "
"وہ دستاویز ویسی ہے جیسی Word42 نے محفوظ کی تھی۔"

#: src/ui/w42-window.c:1188
msgid ""
"Word42 read this PDF from its pages. Saving it writes the pages again, with "
"the document inside for next time."
msgstr ""
"Word42 نے یہ PDF اس کے صفحات سے پڑھی۔ اسے محفوظ کرنے سے صفحات دوبارہ لکھے "
"جاتے ہیں، اگلی بار کے لیے اندر دستاویز کے ساتھ۔"

#. Translators: %s is the name of the file exported to.
#: src/ui/w42-window.c:1289
#, c-format
msgid ""
"Exported as %s. The document itself is not saved there: Word42 cannot read "
"that format back as it was."
msgstr ""
"بطور %s برآمد کی گئی۔ دستاویز خود وہاں محفوظ نہیں کی گئی: Word42 اس فارمیٹ "
"کو اس کی اصل حالت میں واپس نہیں پڑھ سکتا۔"

#: src/ui/w42-window.c:1381
msgid ""
"This document has not been saved yet, so there is nothing to go back to."
msgstr ""
"یہ دستاویز ابھی تک محفوظ نہیں کی گئی، اس لیے واپس جانے کے لیے کچھ نہیں ہے۔"

#: src/ui/w42-window.c:1387
msgid "The document has no unsaved changes."
msgstr "دستاویز میں کوئی غیر محفوظ شدہ تبدیلی نہیں ہے۔"

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1393
#, c-format
msgid "Revert “%s” to the saved version?"
msgstr "“%s” کو محفوظ شدہ ورژن پر واپس لائیں؟"

#: src/ui/w42-window.c:1395
msgid "The changes made since the document was last saved will be lost."
msgstr ""
"دستاویز کو آخری بار محفوظ کرنے کے بعد کی گئی تبدیلیاں ضائع ہو جائیں گی۔"

#: src/ui/w42-window.c:1449
msgid "Word42 saved the document but could not keep it as a version."
msgstr "Word42 نے دستاویز محفوظ کر لی لیکن اسے ورژن کے طور پر نہیں رکھ سکا۔"

#. Translators: %s is what Git said went wrong.
#: src/ui/w42-window.c:1453
#, c-format
msgid "Saved, but Git could not keep it as a version: %s"
msgstr "محفوظ ہو گیا، لیکن Git اسے ورژن کے طور پر نہیں رکھ سکا: %s"

#. Translators: %s is a file name.
#: src/ui/w42-window.c:1559
#, c-format
msgid "“%s” already exists. Replace it?"
msgstr "“%s” پہلے سے موجود ہے۔ اسے تبدیل کریں؟"

#: src/ui/w42-window.c:1566
msgid "The file that is there now will be lost."
msgstr "وہاں موجود فائل ضائع ہو جائے گی۔"

#: src/ui/w42-window.c:1587 src/ui/w42-window.c:1593 src/ui/w42-window.c:1615
#: src/ui/w42-window.c:1745 src/ui/w42-window.c:1771 src/ui/w42-window.c:5535
msgid "Word42 could not save that file."
msgstr "Word42 وہ فائل محفوظ نہیں کر سکا۔"

#: src/ui/w42-window.c:1632
msgid "Save As"
msgstr "بطور محفوظ کریں"

#. Translators: %s is the PDF's file name.
#: src/ui/w42-window.c:1715
#, c-format
msgid "Replace “%s” with Word42's pages?"
msgstr "کیا “%s” کو Word42 کے صفحات سے بدل دیں؟"

#: src/ui/w42-window.c:1718
msgid ""
"Word42 read this PDF from its pages, not from a document of its own. Saved, "
"the PDF is laid out again by Word42, with the document inside it so that it "
"opens as it is now; the pages it has now are not kept."
msgstr ""
"Word42 نے یہ PDF اس کے صفحات سے پڑھی، اپنی کسی دستاویز سے نہیں۔ محفوظ کرنے "
"پر Word42 PDF کو دوبارہ ترتیب دیتا ہے، اندر دستاویز کے ساتھ تاکہ وہ ویسی ہی "
"کھلے جیسی اب ہے؛ اس کے موجودہ صفحات نہیں رکھے جاتے۔"

#: src/ui/w42-window.c:1822 src/ui/w42-window.c:1840
msgid "Word42 could not save that template."
msgstr "Word42 وہ سانچہ محفوظ نہیں کر سکا۔"

#: src/ui/w42-window.c:1824
msgid "Saved as a template.  File > New from Template lists it."
msgstr ""
"سانچے کے طور پر محفوظ ہو گیا۔  فائل > سانچے سے نیا اسے فہرست میں دکھاتا ہے۔"

#: src/ui/w42-window.c:1865
msgid "Save as Template"
msgstr "بطور سانچہ محفوظ کریں"

#: src/ui/w42-window.c:1924
msgid "Don't Save"
msgstr "محفوظ نہ کریں"

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1937
#, c-format
msgid "Save changes to “%s”?"
msgstr "“%s” میں تبدیلیاں محفوظ کریں؟"

#: src/ui/w42-window.c:1940
msgid "If you close without saving, the changes you have made will be lost."
msgstr ""
"اگر آپ محفوظ کیے بغیر بند کرتے ہیں، تو آپ کی کی گئی تبدیلیاں ضائع ہو جائیں "
"گی۔"

#: src/ui/w42-window.c:2641 src/ui/w42-window.c:5048
msgid "Font"
msgstr "فونٹ"

#: src/ui/w42-window.c:2711
msgid "Word42 could not insert that picture."
msgstr "Word42 وہ تصویر داخل نہیں کر سکا۔"

#: src/ui/w42-window.c:2719
msgid "Word42 could not open that picture."
msgstr "Word42 وہ تصویر نہیں کھول سکا۔"

#: src/ui/w42-window.c:2739
msgid "Pictures"
msgstr "تصاویر"

#: src/ui/w42-window.c:2743 src/ui/w42-window.c:4558
msgid "Insert Picture"
msgstr "تصویر داخل کریں"

#: src/ui/w42-window.c:2765
msgid "No scanner can be reached from here."
msgstr "یہاں سے کسی اسکینر تک رسائی نہیں ہو سکتی۔"

#: src/ui/w42-window.c:2766
msgid ""
"Word42 scans through Windows Image Acquisition on Windows and through SANE's "
"scanimage on Linux; neither was found."
msgstr ""
"Word42 Windows پر Windows Image Acquisition کے ذریعے اور Linux پر SANE کے "
"scanimage کے ذریعے اسکین کرتا ہے؛ ان میں سے کوئی بھی نہیں ملا۔"

#: src/ui/w42-window.c:2779
msgid "The scanner sent a picture Word42 cannot read."
msgstr "اسکینر نے ایسی تصویر بھیجی جسے Word42 نہیں پڑھ سکتا۔"

#: src/ui/w42-window.c:2783
msgid "Word42 could not scan."
msgstr "Word42 اسکین نہیں کر سکا۔"

#: src/ui/w42-window.c:2816 src/ui/w42-window.c:2825
msgid "Word42 could not export the PDF."
msgstr "Word42 PDF برآمد نہیں کر سکا۔"

#: src/ui/w42-window.c:2849 src/ui/w42-window.c:2854
msgid "Word42 could not export the web page."
msgstr "Word42 ویب صفحہ برآمد نہیں کر سکا۔"

#: src/ui/w42-window.c:2879
msgid "LaTeX mode: Export as PDF typesets with LaTeX."
msgstr "LaTeX موڈ: بطور PDF برآمد کریں LaTeX سے ٹائپ سیٹ کرتا ہے۔"

#: src/ui/w42-window.c:2881
msgid "LaTeX mode is on, but no TeX engine is installed."
msgstr "LaTeX موڈ آن ہے، لیکن کوئی TeX انجن انسٹال نہیں ہے۔"

#: src/ui/w42-window.c:2882
msgid ""
"Install Tectonic (tectonic-typesetting.github.io), which fetches what it "
"needs by itself, or MiKTeX (miktex.org) or TeX Live (tug.org/texlive). Until "
"then, File > Save As can still write the document as LaTeX (.tex)."
msgstr ""
"Tectonic (tectonic-typesetting.github.io) انسٹال کریں، جو اپنی ضرورت کی "
"چیزیں خود ڈاؤن لوڈ کر لیتا ہے، یا MiKTeX (miktex.org) یا TeX Live (tug.org/"
"texlive)۔ تب تک، فائل > بطور محفوظ کریں پھر بھی دستاویز کو LaTeX (.tex) کے "
"طور پر لکھ سکتا ہے۔"

#: src/ui/w42-window.c:2888
msgid "LaTeX mode is off: Word42 makes the PDFs itself."
msgstr "LaTeX موڈ بند ہے: Word42 PDF فائلیں خود بناتا ہے۔"

#: src/ui/w42-window.c:2982
msgid "Word42 could not write the web page to preview."
msgstr "Word42 پیش منظر کے لیے ویب صفحہ نہیں لکھ سکا۔"

#: src/ui/w42-window.c:3007
msgid "Export as Web Page"
msgstr "بطور ویب صفحہ برآمد کریں"

#: src/ui/w42-window.c:3038 src/ui/w42-window.c:3045
msgid "Word42 could not export the e-book."
msgstr "Word42 ای بک برآمد نہیں کر سکا۔"

#: src/ui/w42-window.c:3040
msgid "The e-book is written."
msgstr "ای بک لکھ دی گئی ہے۔"

#: src/ui/w42-window.c:3068
msgid "E-books (*.epub)"
msgstr "ای بکس (*.epub)"

#: src/ui/w42-window.c:3069
msgid "Export as E-book"
msgstr "بطور ای بک برآمد کریں"

#: src/ui/w42-window.c:3097 src/ui/w42-window.c:3102
msgid "Word42 could not export the presentation."
msgstr "Word42 پریزنٹیشن برآمد نہیں کر سکا۔"

#: src/ui/w42-window.c:3129
msgid "There is nothing to make slides of."
msgstr "سلائیڈز بنانے کے لیے کچھ نہیں ہے۔"

#: src/ui/w42-window.c:3130
msgid ""
"A slide is a heading and the lines under it: give the document's headings "
"the Heading 1 style, or a Title."
msgstr ""
"سلائیڈ ایک سرخی اور اس کے نیچے کی سطروں پر مشتمل ہوتی ہے: دستاویز کی سرخیوں "
"کو Heading 1 طرز دیں، یا Title طرز۔"

#: src/ui/w42-window.c:3135
#, c-format
msgid "%u slide."
msgid_plural "%u slides."
msgstr[0] "%u سلائیڈ۔"
msgstr[1] "%u سلائیڈز۔"

#: src/ui/w42-window.c:3148
msgid "Export as Presentation"
msgstr "بطور پریزنٹیشن برآمد کریں"

#: src/ui/w42-window.c:3180
msgid "Export as PDF"
msgstr "بطور PDF برآمد کریں"

#: src/ui/w42-window.c:3389
msgid "The caret is in the first row: there is nothing above it to split off."
msgstr "کرسر پہلی قطار میں ہے: اس کے اوپر الگ کرنے کے لیے کچھ نہیں ہے۔"

#: src/ui/w42-window.c:3417
msgid "There is nothing to convert here."
msgstr "یہاں تبدیل کرنے کے لیے کچھ نہیں ہے۔"

#: src/ui/w42-window.c:3418
msgid ""
"In a table this makes paragraphs with tabs between the cells; on selected "
"paragraphs it makes a table, split at their tabs."
msgstr ""
"جدول میں یہ خانوں کے درمیان ٹیبز والے پیراگراف بناتا ہے؛ منتخب پیراگرافس پر "
"یہ ان کے ٹیبز کی جگہ سے تقسیم کر کے جدول بناتا ہے۔"

#: src/ui/w42-window.c:3466 src/ui/w42-window.c:3486 src/ui/w42-window.c:3508
#: src/ui/w42-window.c:3934 src/ui/w42-window.c:3950 src/ui/w42-window.c:4174
msgid "The caret is in a note: put it in the body of the document first."
msgstr "کرسر ایک نوٹ میں ہے: پہلے اسے دستاویز کے اصل متن میں رکھیں۔"

#: src/ui/w42-window.c:3472
msgid "There is nothing marked for the index."
msgstr "اشاریے کے لیے کچھ بھی نشان زد نہیں ہے۔"

#: src/ui/w42-window.c:3473
msgid ""
"Select a word and use Insert ▸ Index Entry to mark it, then ask for the "
"index again."
msgstr ""
"کوئی لفظ منتخب کریں اور اسے نشان زد کرنے کے لیے داخل کریں ▸ اشاریہ اندراج "
"استعمال کریں، پھر دوبارہ اشاریہ طلب کریں۔"

#: src/ui/w42-window.c:3492
msgid "There are no captions to list."
msgstr "فہرست میں شامل کرنے کے لیے کوئی کیپشن نہیں ہے۔"

#: src/ui/w42-window.c:3493
msgid ""
"Insert ▸ Caption puts a caption under a picture, and the table of figures "
"lists them."
msgstr ""
"داخل کریں ▸ کیپشن تصویر کے نیچے کیپشن لگاتا ہے، اور اشکال کی فہرست انہیں درج "
"کرتی ہے۔"

#: src/ui/w42-window.c:3514
msgid "There are no headings to list."
msgstr "فہرست میں شامل کرنے کے لیے کوئی سرخی نہیں ہے۔"

#: src/ui/w42-window.c:3515
msgid "Give the document's headings the Heading 1, 2 or 3 style and try again."
msgstr "دستاویز کی سرخیوں کو Heading 1، 2 یا 3 طرز دیں اور دوبارہ کوشش کریں۔"

#: src/ui/w42-window.c:3562
msgid "There is no table of contents to update."
msgstr "اپ ڈیٹ کرنے کے لیے کوئی فہرست مضامین نہیں ہے۔"

#: src/ui/w42-window.c:3563
msgid "Insert > Table of Contents puts one in."
msgstr "داخل کریں > فہرست مضامین ایک فہرست مضامین داخل کرتا ہے۔"

#: src/ui/w42-window.c:3599
msgid "No hyphenation dictionary was found."
msgstr "ہائفن بندی کی کوئی لغت نہیں ملی۔"

#: src/ui/w42-window.c:3600
msgid ""
"Hyphenation needs libhyphen and a hyph_*.dic pattern file for your language, "
"the ones LibreOffice uses."
msgstr ""
"ہائفن بندی کے لیے libhyphen اور آپ کی زبان کے لیے hyph_*.dic پیٹرن فائل "
"درکار ہے، وہی جو LibreOffice استعمال کرتا ہے۔"

#: src/ui/w42-window.c:3603
msgid "There is nothing to hyphenate."
msgstr "ہائفن لگانے کے لیے کچھ نہیں ہے۔"

#: src/ui/w42-window.c:3615
#, c-format
msgid "%d hyphen removed."
msgid_plural "%d hyphens removed."
msgstr[0] "%d ہائفن ہٹایا گیا۔"
msgstr[1] "%d ہائفن ہٹائے گئے۔"

#: src/ui/w42-window.c:3618
msgid "There are no soft hyphens to remove."
msgstr "ہٹانے کے لیے کوئی نرم ہائفن نہیں ہے۔"

#: src/ui/w42-window.c:3771
msgid ""
"Type the name of an AutoText entry, then press Ctrl+F3.  Edit > AutoText "
"makes one from the selection."
msgstr ""
"کسی خودکار متن اندراج کا نام ٹائپ کریں، پھر Ctrl+F3 دبائیں۔  ترمیم > خودکار "
"متن انتخاب سے ایک اندراج بناتا ہے۔"

#: src/ui/w42-window.c:3812
#, c-format
msgid "%d field updated."
msgid_plural "%d fields updated."
msgstr[0] "%d فیلڈ اپ ڈیٹ ہوئی۔"
msgstr[1] "%d فیلڈز اپ ڈیٹ ہوئیں۔"

#: src/ui/w42-window.c:3815
msgid "There are no fields in this document."
msgstr "اس دستاویز میں کوئی فیلڈ نہیں ہے۔"

#. Translators: the label Insert > Caption puts in the document; %d is
#. * the figure's number.  Keep a word before the number, and keep %d as
#. * it is: the captions already there are counted by what comes before
#. * it.
#: src/ui/w42-window.c:3885 src/ui/w42-window.c:3901
#, c-format
msgid "Figure %d: "
msgstr "شکل %d: "

#: src/ui/w42-window.c:3964
msgid "Put the caret at a note's mark, or in the note itself."
msgstr "کرسر کو نوٹ کے نشان پر، یا خود نوٹ میں رکھیں۔"

#: src/ui/w42-window.c:4046
msgid "No thesaurus was found."
msgstr "کوئی ذخیرہ الفاظ نہیں ملا۔"

#: src/ui/w42-window.c:4047
msgid ""
"The thesaurus needs a MyThes file for the language of the text -- "
"th_en_US_v2.dat and its .idx for English, th_nb_NO_v2 for Norwegian, the "
"ones LibreOffice uses -- in the mythes folder."
msgstr ""
"ذخیرہ الفاظ کو mythes فولڈر میں متن کی زبان کے لیے MyThes فائل درکار ہے -- "
"انگریزی کے لیے th_en_US_v2.dat اور اس کی .idx، نارویجین کے لیے th_nb_NO_v2، "
"وہی جو LibreOffice استعمال کرتا ہے۔"

#: src/ui/w42-window.c:4054
msgid "Put the caret in a word to look it up in the thesaurus."
msgstr "ذخیرہ الفاظ میں کوئی لفظ دیکھنے کے لیے کرسر اس لفظ میں رکھیں۔"

#: src/ui/w42-window.c:4066
msgid "No spelling dictionary was found."
msgstr "ہجے کی کوئی لغت نہیں ملی۔"

#: src/ui/w42-window.c:4067
msgid "Install a Hunspell dictionary for your language and start Word42 again."
msgstr "اپنی زبان کے لیے Hunspell لغت انسٹال کریں اور Word42 دوبارہ شروع کریں۔"

#: src/ui/w42-window.c:4120
msgid "Revisions accepted."
msgstr "نظرثانیاں قبول کر لی گئیں۔"

#: src/ui/w42-window.c:4122 src/ui/w42-window.c:4134
msgid "There are no revision marks in this document."
msgstr "اس دستاویز میں نظرثانی کے کوئی نشانات نہیں ہیں۔"

#: src/ui/w42-window.c:4132
msgid "Revisions rejected."
msgstr "نظرثانیاں مسترد کر دی گئیں۔"

#. Translators: the Windows version in the About box, as "Windows
#. * 10.0 build 19045 (Windows 10)": the major and minor version, the
#. * build number, then the release's name in brackets or nothing.
#: src/ui/w42-window.c:4245
#, c-format
msgid "Windows %lu.%lu build %lu%s"
msgstr "Windows %lu.%lu بلڈ %lu%s"

#. Translators: what the About box says this copy runs on, for bug
#. * reports.  The version numbers and library names fill the
#. * placeholders in turn: Word42's version; GTK's running version and
#. * the one built against; GLib's; Pango's, Cairo's and GdkPixbuf's;
#. * the operating system; then the spelling, hyphenation and PDF
#. * import libraries, or "none".
#: src/ui/w42-window.c:4276
#, c-format
msgid ""
"Word42 %s\n"
"GTK %u.%u.%u (built against %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"Spelling: %s  ·  Hyphenation: %s  ·  PDF import: %s"
msgstr ""
"Word42 %s\n"
"GTK %u.%u.%u (%d.%d.%d کے ساتھ بلڈ کیا گیا)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"ہجے: %s  ·  ہائفن بندی: %s  ·  PDF درآمد: %s"

#. Translators: no library for this, in the About box.
#: src/ui/w42-window.c:4291 src/ui/w42-window.c:4297 src/ui/w42-window.c:4303
msgctxt "library"
msgid "none"
msgstr "کوئی نہیں"

#: src/ui/w42-window.c:4335
msgid "About Word42"
msgstr "Word42 کے بارے میں"

#. Translators: %s is Word42's version number.
#: src/ui/w42-window.c:4358
#, c-format
msgid "Version %s"
msgstr "ورژن %s"

#: src/ui/w42-window.c:4369
msgid "Written in C on GTK 4, Pango and Cairo."
msgstr "GTK 4، Pango اور Cairo پر C میں لکھا گیا۔"

