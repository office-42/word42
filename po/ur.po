#, c-format
msgid "Word42 could not write the PDF: %s"
msgstr "Word42 PDF نہیں لکھ سکا: %s"

#: src/io/w42-pdf.c:433 src/io/w42-pdf.c:465 src/io/w42-pdfsec.c:470
#, c-format
msgid "Word42 could not sign the PDF."
msgstr "Word42 PDF پر دستخط نہیں کر سکا۔"

#: src/io/w42-pdf.c:447
#, c-format
msgid "The PDF is too large to be signed."
msgstr "PDF اتنی بڑی ہے کہ اس پر دستخط نہیں ہو سکتے۔"

#: src/io/w42-pdf.c:539
#, c-format
msgid "Word42 could not put the document in the PDF."
msgstr "Word42 دستاویز کو PDF میں نہیں رکھ سکا۔"

#: src/io/w42-pdf.c:575
#, c-format
msgid "No certificate to sign the PDF with has been chosen."
msgstr "PDF پر دستخط کے لیے کوئی سرٹیفکیٹ منتخب نہیں کیا گیا۔"

#: src/io/w42-pdf.c:2623
msgid "The password is not correct."
msgstr "پاس ورڈ درست نہیں ہے۔"

#: src/io/w42-pdf.c:2624
msgid "The PDF is protected with a password."
msgstr "PDF پاس ورڈ سے محفوظ ہے۔"

#. Translators: poppler is the name of a program library;
#. * keep it as it is.
#: src/io/w42-pdf.c:2726
#, c-format
msgid ""
"This build of Word42 cannot read PDF files. It was built without poppler."
msgstr ""
"Word42 کا یہ بلڈ PDF فائلیں نہیں پڑھ سکتا۔ اسے poppler کے بغیر بنایا گیا تھا۔"

#: src/io/w42-pdffile.c:1303
#, c-format
msgid "The PDF could not be read back to be finished."
msgstr "PDF کو مکمل کرنے کے لیے دوبارہ نہیں پڑھا جا سکا۔"

#: src/io/w42-pdfsec.c:215
#, c-format
msgid "Word42 could not encrypt the PDF."
msgstr "Word42 PDF کی خفیہ کاری نہیں کر سکا۔"

#. Translators: the first %s is a certificate file's name, the second
#. * what is wrong with it.
#: src/io/w42-pdfsec.c:305
#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#: src/io/w42-pdfsec.c:335
msgid ""
"this is not a certificate file Word42 can read. It wants a PKCS #12 file (."
"p12 or .pfx) with the certificate and its private key."
msgstr ""
"یہ ایسی سرٹیفکیٹ فائل نہیں جو Word42 پڑھ سکے۔ اسے سرٹیفکیٹ اور اس کی نجی "
"کلید والی PKCS #12 فائل (.p12 یا .pfx) درکار ہے۔"

#: src/io/w42-pdfsec.c:345 src/io/w42-pdfsec.c:358
msgid "the certificate's password is not correct."
msgstr "سرٹیفکیٹ کا پاس ورڈ درست نہیں ہے۔"

#: src/io/w42-pdfsec.c:359
msgid "the file has no certificate with a private key to sign with."
msgstr "فائل میں دستخط کے لیے نجی کلید والا کوئی سرٹیفکیٹ نہیں ہے۔"

#: src/io/w42-pdfsec.c:369
msgid "the private key cannot be used to sign."
msgstr "نجی کلید دستخط کے لیے استعمال نہیں ہو سکتی۔"

#: src/io/w42-pdfsec.c:378
msgid "the certificate has expired."
msgstr "سرٹیفکیٹ کی میعاد ختم ہو چکی ہے۔"

#: src/io/w42-pdfsec.c:384
msgid "the certificate is not valid yet."
msgstr "سرٹیفکیٹ ابھی درست نہیں ہے۔"

#: src/io/w42-pdfsec.c:500
#, c-format
msgid "Word42 could not sign the PDF: %s"
msgstr "Word42 PDF پر دستخط نہیں کر سکا: %s"

#. Translators: GnuTLS is the name of a program library;
#. * keep it as it is.
#. Translators: GnuTLS is the name of a program library; keep it
#. * as it is.
#: src/io/w42-pdfsec.c:530 src/ui/w42-dialogs.c:7704
#, c-format
msgid ""
"This build of Word42 cannot put a password on a PDF or sign one. It was "
"built without GnuTLS."
msgstr ""
"Word42 کا یہ بلڈ PDF پر پاس ورڈ نہیں لگا سکتا اور نہ اس پر دستخط کر سکتا ہے۔ "
"اسے GnuTLS کے بغیر بنایا گیا تھا۔"

#. Translators: the heading given to a slide that has no title of its
#. * own, when a presentation is opened.
#: src/io/w42-pptx.c:1288
msgid "Slide"
msgstr "سلائیڈ"

#. Translators: ppt/presentation.xml is the name of a file
#. * inside a .pptx; keep it as it is.
#: src/io/w42-pptx.c:1383
#, c-format
msgid "That file is not a presentation: it has no ppt/presentation.xml."
msgstr "وہ فائل پریزنٹیشن نہیں ہے: اس میں ppt/presentation.xml موجود نہیں ہے۔"

#: src/io/w42-rtf.c:4397
#, c-format
msgid "That file does not begin like an RTF document."
msgstr "وہ فائل RTF دستاویز کی طرح شروع نہیں ہوتی۔"

#: src/io/w42-zip.c:166 src/io/w42-zip.c:182
#, c-format
msgid "Not a zip file."
msgstr "zip فائل نہیں ہے۔"

#: src/io/w42-zip.c:193
#, c-format
msgid "The zip file is cut short."
msgstr "zip فائل ادھوری ہے۔"

#. Translators: %d is a line of the macro, %s what is wrong with it.
#: src/macro/w42-vba.c:276 src/ui/w42-macro.c:2794
#, c-format
msgid "Line %d: %s"
msgstr "سطر %d: %s"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:593
msgid "a name starting with a dot needs a With block"
msgstr "نقطے سے شروع ہونے والے نام کے لیے With بلاک درکار ہے"

#: src/macro/w42-vba.c:812
msgid "a named argument outside a call"
msgstr "کال سے باہر نامزد آرگیومنٹ"

#. Translators: Sub and Function are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:875
msgid "Sub or Function without a name"
msgstr "نام کے بغیر Sub یا Function"

#. Translators: "Optional" is a macro keyword: keep it in
#. * English.
#: src/macro/w42-vba.c:913
msgid "an Optional parameter with a default value is not supported"
msgstr "طے شدہ قدر والے Optional پیرامیٹر کی معاونت نہیں ہے"

#. Translators: "Dim" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:941
msgid "Dim expects a name"
msgstr "Dim کے بعد نام درکار ہے"

#. Translators: "New" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:960
msgid "objects made with New are not supported"
msgstr "New سے بنائے گئے آبجیکٹس کی معاونت نہیں ہے"

#. Translators: "Dim a(10)" is macro code: keep it as it
#. * is.
#: src/macro/w42-vba.c:998
msgid "an array's size must be a number: Dim a(10)"
msgstr "ارے کا سائز عدد ہونا چاہیے: Dim a(10)"

#. Translators: End Sub, Sub, End Function and Function
#. * are macro keywords: keep them in English.
#: src/macro/w42-vba.c:1150
msgid "End Sub without Sub"
msgstr "Sub کے بغیر End Sub"

#: src/macro/w42-vba.c:1151
msgid "End Function without Function"
msgstr "Function کے بغیر End Function"

#. Translators: the first %s is a macro keyword (Sub,
#. * Function, If, For, Do, Select Case or With), the
#. * second Sub or Function; "End" is a keyword too.  Keep
#. * them all in English.
#: src/macro/w42-vba.c:1160
#, c-format
msgid "%s is still open at End %s"
msgstr "End %2$s پر %1$s ابھی تک کھلا ہے"

#. Translators: End If and If are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1177
msgid "End If without If"
msgstr "If کے بغیر End If"

#. Translators: End Select and Select are macro keywords:
#. * keep them in English.
#: src/macro/w42-vba.c:1185
msgid "End Select without Select"
msgstr "Select کے بغیر End Select"

#. Translators: End With and With are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1193
msgid "End With without With"
msgstr "With کے بغیر End With"

#. Translators: "End" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1198
msgid "End of what?"
msgstr "کس چیز کا End؟"

#. Translators: "Exit" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1216
msgid "Exit of what?"
msgstr "کس چیز سے Exit؟"

#. Translators: If and Then are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1228
msgid "If without Then"
msgstr "Then کے بغیر If"

#. Translators: Select and Case are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1289
msgid "Select without Case"
msgstr "Case کے بغیر Select"

#. Translators: Case and Select Case are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1308
msgid "Case outside Select Case"
msgstr "Select Case سے باہر Case"

#. Translators: "For Each" is a macro keyword, and "For i = 1
#. * To ...Count" macro code: keep them in English.
#: src/macro/w42-vba.c:1331
msgid "For Each is not supported: count with For i = 1 To ...Count"
msgstr "For Each کی معاونت نہیں ہے: For i = 1 To ...Count سے گنیں"

#. Translators: "For" is a macro keyword, and "For i = a To
#. * b" macro code: keep them in English.
#: src/macro/w42-vba.c:1344
msgid "For expects: For i = a To b"
msgstr "For کی متوقع شکل: For i = a To b"

#. Translators: Next and For are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1369
msgid "Next without For"
msgstr "For کے بغیر Next"

#. Translators: Wend and While are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1414
msgid "Wend without While"
msgstr "While کے بغیر Wend"

#. Translators: Loop and Do are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1427
msgid "Loop without Do"
msgstr "Do کے بغیر Loop"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1463
msgid "With without an object"
msgstr "آبجیکٹ کے بغیر With"

#. Translators: "Const" is a macro keyword: keep it in English.
#. * NAME and value stand for what is written there.
#: src/macro/w42-vba.c:1497
msgid "Const expects NAME = value"
msgstr "Const کے بعد نام = قدر درکار ہے"

#. Translators: "GoTo" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1514
msgid "GoTo and labels are not supported"
msgstr "GoTo اور لیبلز کی معاونت نہیں ہے"

#: src/macro/w42-vba.c:1559
msgid "an indexed object property cannot be set"
msgstr "آبجیکٹ کی انڈیکس شدہ خاصیت سیٹ نہیں کی جا سکتی"

#: src/macro/w42-vba.c:1592
msgid "a statement that does not start with a name"
msgstr "ایسا بیان جو کسی نام سے شروع نہیں ہوتا"

#: src/macro/w42-vba.c:1770
msgid "labels are not supported"
msgstr "لیبلز کی معاونت نہیں ہے"

#. Translators: %s is a macro keyword (Sub, Function, If, For, Do,
#. * Select Case or With): keep it in English.
#: src/macro/w42-vba.c:1803
#, c-format
msgid "%s is never ended"
msgstr "%s کبھی ختم نہیں کیا گیا"

#. Translators: "Sub" is a macro keyword: keep it in English.
#. * %s is the Sub's name.
#: src/macro/w42-vba.c:1820
#, c-format
msgid "There is no Sub named %s in this macro."
msgstr "اس میکرو میں %s نام کا کوئی Sub نہیں ہے۔"

#: src/main.c:207
msgid "Usage: word42 --convert-to=FORMAT [--outdir=DIR] FILE..."
msgstr "استعمال: word42 --convert-to=FORMAT [--outdir=DIR] FILE..."

#: src/main.c:208
msgid ""
"FORMAT is the extension to write: pdf, epub, odt, docx, rtf, html, txt, abw "
"or tex."
msgstr ""
"FORMAT لکھی جانے والی فائل کی ایکسٹینشن ہے: pdf, epub, odt, docx, rtf, html, "
"txt, abw یا tex۔"

#: src/main.c:220
msgid "the folder could not be made"
msgstr "فولڈر نہیں بنایا جا سکا"

#: src/main.c:255
msgid "already in that format"
msgstr "پہلے ہی اس فارمیٹ میں ہے"

#: src/main.c:265
msgid "could not be converted"
msgstr "تبدیل نہیں کی جا سکی"

