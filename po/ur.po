msgstr "_کھولیں"

#: src/ui/w42-versions.c:798
msgid "Co_mpare"
msgstr "_موازنہ کریں"

#: src/ui/w42-versions.c:799
msgid "_Restore..."
msgstr "_بحال کریں..."

#: src/ui/w42-view.c:1274
msgid "Open this link?"
msgstr "یہ لنک کھولیں؟"

