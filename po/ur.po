msgid "Envelope C5 (229 x 162 mm)"
msgstr "لفافہ C5 (229 x 162 مم)"

#: src/model/w42-envelope.c:26
msgid "Envelope C6 (162 x 114 mm)"
msgstr "لفافہ C6 (162 x 114 مم)"

#: src/model/w42-envelope.c:27
