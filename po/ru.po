#: src/util/w42-mathtex.c:353
msgid "The braces do not balance."
msgstr "Фигурные скобки не сбалансированы."

#: src/util/w42-mathtex.c:445
msgid "\\begin and \\end name different environments."
msgstr "\\begin и \\end называют разные окружения."

#: src/util/w42-mathtex.c:448
msgid "An environment has no \\end."
msgstr "У окружения нет \\end."

#: src/util/w42-mathtex.c:505
msgid "\\begin names no environment."
msgstr "\\begin не называет окружение."

#: src/util/w42-mathtex.c:822
msgid "\\left has no \\right."
msgstr "У \\left нет \\right."

#: src/util/w42-mathtex.c:1104 src/util/w42-mathtex.c:1137
msgid "Something is missing after a command, a ^ or a _."
msgstr "После команды, ^ или _ чего-то не хватает."

#: src/util/w42-mathtex.c:1263
msgid "A } has no { before it."
msgstr "Перед } нет {."

#: src/util/w42-mathtex.c:1265
msgid "\\right has no \\left."
msgstr "У \\right нет \\left."

#: src/util/w42-mathtex.c:1267
msgid "\\end has no \\begin."
