#. * first %s is the document's name, the second an asterisk when it has
#. * unsaved changes (else nothing), the third Word42's version.
#: src/ui/w42-window.c:275
#, c-format
msgid "%s%s - Word42 %s"
msgstr "%s%s - Word42 %s"

#. Translators: the title in Word42's own title bar, "Word42 0.9.0 -
#. * Document1".  The first %s is Word42's version, the second the
#. * document's name, the third an asterisk when it has unsaved
#. * changes (else nothing).
#: src/ui/w42-window.c:287
#, c-format
msgid "Word42 %s - %s%s"
msgstr "Word42 %s - %s%s"

#: src/ui/w42-window.c:344
msgid ""
"All Documents (*.doc, *.rtf, *.docx, *.odt, *.abw, *.wpd, *.txt, *.pdf, *."
"html)"
msgstr ""
"Все документы (*.doc, *.rtf, *.docx, *.odt, *.abw, *.wpd, *.txt, *.pdf, *."
"html)"

#: src/ui/w42-window.c:347
msgid ""
"All Documents (*.rtf, *.docx, *.doc, *.odt, *.abw, *.wpd, *.txt, *.pdf, *."
"html)"
msgstr ""
"Все документы (*.rtf, *.docx, *.doc, *.odt, *.abw, *.wpd, *.txt, *.pdf, *."
"html)"

#: src/ui/w42-window.c:349
msgid "Word 97 (*.doc)"
msgstr "Документ Word 97 (*.doc)"

#: src/ui/w42-window.c:351
msgid "Word Document (*.docx)"
msgstr "Документ Word (*.docx)"

#: src/ui/w42-window.c:352
msgid "OpenDocument Text (*.odt)"
msgstr "Текст OpenDocument (*.odt)"

#: src/ui/w42-window.c:353
msgid "AbiWord (*.abw, *.zabw)"
msgstr "Документ AbiWord (*.abw, *.zabw)"

#: src/ui/w42-window.c:354
msgid "WordPerfect 6 (*.wpd)"
msgstr "Документ WordPerfect 6 (*.wpd)"

#: src/ui/w42-window.c:354
msgid "WordPerfect (*.wpd, *.wp)"
msgstr "Документ WordPerfect (*.wpd, *.wp)"

#: src/ui/w42-window.c:356
msgid "LaTeX (*.tex)"
msgstr "Документ LaTeX (*.tex)"

#: src/ui/w42-window.c:357 src/ui/w42-window.c:2704
msgid "Web Pages (*.html)"
msgstr "Веб-страницы (*.html)"

#: src/ui/w42-window.c:358 src/ui/w42-window.c:2845
msgid "Presentations (*.pptx)"
msgstr "Презентации (*.pptx)"

#: src/ui/w42-window.c:359
msgid "Text Documents (*.txt)"
msgstr "Текстовые документы (*.txt)"

#: src/ui/w42-window.c:362
msgid "All Files"
msgstr "Все файлы"

#. Translators: the name of the copy Tools > Options > Always create
#. * backup copy keeps beside a file; %s is the file's own name.  It is a
#. * file name: no slashes, backslashes or colons, and %s last, so that the
#. * copy keeps the file's extension and opens as the file does.
#: src/ui/w42-window.c:615
#, c-format
msgid "Backup of %s"
msgstr "Резервная копия %s"

#. Translators: %s is the recovered document's name.
#: src/ui/w42-window.c:689
#, c-format
msgid "Word42 recovered “%s”."
msgstr "Word42 восстановил «%s»."

#: src/ui/w42-window.c:692
msgid ""
"It was not saved when Word42 last stopped. Save it to keep it; close it to "
"let it go."
msgstr ""
"Документ не был сохранен при последнем завершении работы Word42. Сохраните "
"его, чтобы не потерять, или закройте, если он не нужен."

#. Translators: %d is how many autosaved copies could not be read,
#. * %s the folder they are kept in.
#: src/ui/w42-window.c:737
#, c-format
msgid ""
"%d document left when Word42 last stopped could not be read. It is kept in "
"%s, with names ending .bad."
msgid_plural ""
"%d documents left when Word42 last stopped could not be read. They are kept "
"in %s, with names ending .bad."
msgstr[0] ""
"%d документ, оставшийся после последнего завершения работы Word42, не "
"удалось прочитать. Он хранится в папке %s, имя оканчивается на .bad."
msgstr[1] ""
"%d документа, оставшихся после последнего завершения работы Word42, не "
"удалось прочитать. Они хранятся в папке %s, имена оканчиваются на .bad."
msgstr[2] ""
"%d документов, оставшихся после последнего завершения работы Word42, не "
"удалось прочитать. Они хранятся в папке %s, имена оканчиваются на .bad."

#: src/ui/w42-window.c:747
msgid "Word42 could not recover everything."
msgstr "Word42 не удалось восстановить все документы."

#: src/ui/w42-window.c:942 src/ui/w42-window.c:1016 src/ui/w42-window.c:1096
#: src/ui/w42-window.c:5445
msgid "Word42 could not open that file."
msgstr "Word42 не удалось открыть этот файл."

#. Translators: %s is the name of the file exported to.
#: src/ui/w42-window.c:1046
#, c-format
msgid ""
"Exported as %s. The document itself is not saved there: Word42 cannot read "
"that format back as it was."
msgstr ""
"Экспортировано в %s. Сам документ там не сохранен: Word42 не может прочитать "
"этот формат обратно без потерь."

#: src/ui/w42-window.c:1138
msgid ""
"This document has not been saved yet, so there is nothing to go back to."
msgstr "Документ еще не сохранялся, поэтому восстанавливать нечего."

#: src/ui/w42-window.c:1144
msgid "The document has no unsaved changes."
msgstr "В документе нет несохраненных изменений."

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1150
#, c-format
msgid "Revert “%s” to the saved version?"
msgstr "Восстановить сохраненную версию «%s»?"

#: src/ui/w42-window.c:1152
msgid "The changes made since the document was last saved will be lost."
msgstr ""
"Изменения, внесенные после последнего сохранения документа, будут потеряны."

#: src/ui/w42-window.c:1206
msgid "Word42 saved the document but could not keep it as a version."
msgstr "Word42 сохранил документ, но не смог сохранить его как версию."

#. Translators: %s is what Git said went wrong.
#: src/ui/w42-window.c:1210
#, c-format
msgid "Saved, but Git could not keep it as a version: %s"
msgstr "Документ сохранен, но Git не смог сохранить его как версию: %s"

#. Translators: %s is a file name.
#: src/ui/w42-window.c:1316
#, c-format
msgid "“%s” already exists. Replace it?"
msgstr "«%s» уже существует. Заменить?"

#: src/ui/w42-window.c:1323
msgid "The file that is there now will be lost."
msgstr "Существующий файл будет потерян."

#: src/ui/w42-window.c:1344 src/ui/w42-window.c:1350 src/ui/w42-window.c:1372
#: src/ui/w42-window.c:1452 src/ui/w42-window.c:1478 src/ui/w42-window.c:5351
msgid "Word42 could not save that file."
msgstr "Word42 не удалось сохранить этот файл."

#: src/ui/w42-window.c:1389
msgid "Save As"
msgstr "Сохранить как"

#: src/ui/w42-window.c:1529 src/ui/w42-window.c:1547
msgid "Word42 could not save that template."
msgstr "Word42 не удалось сохранить этот шаблон."

#: src/ui/w42-window.c:1531
msgid "Saved as a template.  File > New from Template lists it."
msgstr "Сохранено как шаблон. Он появится в списке Файл > Создать из шаблона."

#: src/ui/w42-window.c:1572
msgid "Save as Template"
msgstr "Сохранить как шаблон"

#: src/ui/w42-window.c:1631
msgid "Don't Save"
msgstr "Не сохранять"

#. Translators: %s is the document's name.
#: src/ui/w42-window.c:1644
#, c-format
msgid "Save changes to “%s”?"
msgstr "Сохранить изменения в «%s»?"

#: src/ui/w42-window.c:1647
msgid "If you close without saving, the changes you have made will be lost."
msgstr ""
"Если закрыть документ без сохранения, внесенные изменения будут потеряны."

#: src/ui/w42-window.c:2348 src/ui/w42-window.c:4877
msgid "Font"
msgstr "Шрифт"

#: src/ui/w42-window.c:2418
msgid "Word42 could not insert that picture."
msgstr "Word42 не удалось вставить этот рисунок."

#: src/ui/w42-window.c:2426
msgid "Word42 could not open that picture."
msgstr "Word42 не удалось открыть этот рисунок."

#: src/ui/w42-window.c:2446
msgid "Pictures"
msgstr "Рисунки"

#: src/ui/w42-window.c:2450 src/ui/w42-window.c:4387
msgid "Insert Picture"
msgstr "Вставка рисунка"

#: src/ui/w42-window.c:2472
msgid "No scanner can be reached from here."
msgstr "Нет доступного сканера."

#: src/ui/w42-window.c:2473
msgid ""
"Word42 scans through Windows Image Acquisition on Windows and through SANE's "
"scanimage on Linux; neither was found."
msgstr ""
"Word42 сканирует через Windows Image Acquisition в Windows и через программу "
"scanimage из SANE в Linux; ни то, ни другое не найдено."

#: src/ui/w42-window.c:2486
msgid "The scanner sent a picture Word42 cannot read."
msgstr "Сканер передал изображение, которое Word42 не может прочитать."

#: src/ui/w42-window.c:2490
msgid "Word42 could not scan."
msgstr "Word42 не удалось выполнить сканирование."

#: src/ui/w42-window.c:2516 src/ui/w42-window.c:2523
msgid "Word42 could not export the PDF."
msgstr "Word42 не удалось экспортировать PDF."

#: src/ui/w42-window.c:2547 src/ui/w42-window.c:2552
msgid "Word42 could not export the web page."
msgstr "Word42 не удалось экспортировать веб-страницу."

#: src/ui/w42-window.c:2577
msgid "LaTeX mode: Export as PDF typesets with LaTeX."
msgstr ""
"Режим LaTeX: команда «Экспорт в PDF» верстает документ с помощью LaTeX."

#: src/ui/w42-window.c:2579
msgid "LaTeX mode is on, but no TeX engine is installed."
msgstr "Режим LaTeX включен, но движок TeX не установлен."

#: src/ui/w42-window.c:2580
msgid ""
"Install Tectonic (tectonic-typesetting.github.io), which fetches what it "
"needs by itself, or MiKTeX (miktex.org) or TeX Live (tug.org/texlive). Until "
"then, File > Save As can still write the document as LaTeX (.tex)."
msgstr ""
"Установите Tectonic (tectonic-typesetting.github.io), который сам загружает "
"все необходимое, либо MiKTeX (miktex.org) или TeX Live (tug.org/texlive). А "
"пока команда Файл > Сохранить как по-прежнему может записать документ в "
"формате LaTeX (.tex)."

#: src/ui/w42-window.c:2586
msgid "LaTeX mode is off: Word42 makes the PDFs itself."
msgstr "Режим LaTeX выключен: Word42 создает файлы PDF сам."

#: src/ui/w42-window.c:2680
msgid "Word42 could not write the web page to preview."
msgstr "Word42 не удалось записать веб-страницу для просмотра."

#: src/ui/w42-window.c:2705
msgid "Export as Web Page"
msgstr "Экспорт в веб-страницу"

#: src/ui/w42-window.c:2736 src/ui/w42-window.c:2743
msgid "Word42 could not export the e-book."
msgstr "Word42 не удалось экспортировать электронную книгу."

#: src/ui/w42-window.c:2738
msgid "The e-book is written."
msgstr "Электронная книга записана."

#: src/ui/w42-window.c:2766
msgid "E-books (*.epub)"
msgstr "Электронные книги (*.epub)"

#: src/ui/w42-window.c:2767
msgid "Export as E-book"
msgstr "Экспорт в электронную книгу"

#: src/ui/w42-window.c:2795 src/ui/w42-window.c:2800
msgid "Word42 could not export the presentation."
msgstr "Word42 не удалось экспортировать презентацию."

#: src/ui/w42-window.c:2827
msgid "There is nothing to make slides of."
msgstr "Не из чего создавать слайды."

#: src/ui/w42-window.c:2828
msgid ""
"A slide is a heading and the lines under it: give the document's headings "
"the Heading 1 style, or a Title."
msgstr ""
"Слайд — это заголовок и строки под ним: примените к заголовкам документа "
"стиль Heading 1 или Title."

#: src/ui/w42-window.c:2833
#, c-format
msgid "%u slide."
msgid_plural "%u slides."
msgstr[0] "%u слайд."
msgstr[1] "%u слайда."
msgstr[2] "%u слайдов."

#: src/ui/w42-window.c:2846
msgid "Export as Presentation"
msgstr "Экспорт в презентацию"

#: src/ui/w42-window.c:2878
msgid "Export as PDF"
msgstr "Экспорт в PDF"

#: src/ui/w42-window.c:3087
msgid "The caret is in the first row: there is nothing above it to split off."
msgstr "Курсор находится в первой строке: над ней нечего отделять."

#: src/ui/w42-window.c:3115
msgid "There is nothing to convert here."
msgstr "Здесь нечего преобразовывать."

#: src/ui/w42-window.c:3116
msgid ""
"In a table this makes paragraphs with tabs between the cells; on selected "
"paragraphs it makes a table, split at their tabs."
msgstr ""
"В таблице эта команда создает абзацы с табуляциями между ячейками; из "
"выделенных абзацев она создает таблицу, разбивая их по табуляциям."

#: src/ui/w42-window.c:3164 src/ui/w42-window.c:3184 src/ui/w42-window.c:3206
#: src/ui/w42-window.c:3632 src/ui/w42-window.c:3648 src/ui/w42-window.c:3872
msgid "The caret is in a note: put it in the body of the document first."
msgstr ""
"Курсор находится в сноске: сначала поместите его в основной текст документа."

#: src/ui/w42-window.c:3170
msgid "There is nothing marked for the index."
msgstr "Нет элементов, помеченных для указателя."

#: src/ui/w42-window.c:3171
msgid ""
"Select a word and use Insert ▸ Index Entry to mark it, then ask for the "
"index again."
msgstr ""
"Выделите слово, пометьте его командой Вставка ▸ Пометить элемент указателя, "
"а затем снова вставьте указатель."

#: src/ui/w42-window.c:3190
msgid "There are no captions to list."
msgstr "Нет названий для списка иллюстраций."

#: src/ui/w42-window.c:3191
msgid ""
"Insert ▸ Caption puts a caption under a picture, and the table of figures "
"lists them."
msgstr ""
"Команда Вставка ▸ Название добавляет название под рисунком, а список "
"иллюстраций собирает их."

#: src/ui/w42-window.c:3212
msgid "There are no headings to list."
msgstr "Нет заголовков для оглавления."

#: src/ui/w42-window.c:3213
msgid "Give the document's headings the Heading 1, 2 or 3 style and try again."
msgstr ""
"Примените к заголовкам документа стиль Heading 1, 2 или 3 и повторите "
"попытку."

#: src/ui/w42-window.c:3260
msgid "There is no table of contents to update."
msgstr "Нет оглавления для обновления."

#: src/ui/w42-window.c:3261
msgid "Insert > Table of Contents puts one in."
msgstr "Вставить его можно командой Вставка > Оглавление."

#: src/ui/w42-window.c:3297
msgid "No hyphenation dictionary was found."
msgstr "Словарь переносов не найден."

#: src/ui/w42-window.c:3298
msgid ""
"Hyphenation needs libhyphen and a hyph_*.dic pattern file for your language, "
"the ones LibreOffice uses."
msgstr ""
"Для расстановки переносов нужны libhyphen и файл шаблонов hyph_*.dic для "
"вашего языка — те же, что использует LibreOffice."

#: src/ui/w42-window.c:3301
msgid "There is nothing to hyphenate."
msgstr "Нет текста для расстановки переносов."

#: src/ui/w42-window.c:3313
#, c-format
msgid "%d hyphen removed."
msgid_plural "%d hyphens removed."
msgstr[0] "Удален %d перенос."
msgstr[1] "Удалено %d переноса."
msgstr[2] "Удалено %d переносов."

#: src/ui/w42-window.c:3316
msgid "There are no soft hyphens to remove."
msgstr "Нет мягких переносов для удаления."

#: src/ui/w42-window.c:3469
msgid ""
"Type the name of an AutoText entry, then press Ctrl+F3.  Edit > AutoText "
"makes one from the selection."
msgstr ""
"Введите имя элемента автотекста и нажмите Ctrl+F3. Команда Правка > "
"Автотекст создает элемент из выделенного фрагмента."

#: src/ui/w42-window.c:3510
#, c-format
msgid "%d field updated."
msgid_plural "%d fields updated."
msgstr[0] "Обновлено %d поле."
msgstr[1] "Обновлено %d поля."
msgstr[2] "Обновлено %d полей."

#: src/ui/w42-window.c:3513
msgid "There are no fields in this document."
msgstr "В документе нет полей."

#. Translators: the label Insert > Caption puts in the document; %d is
#. * the figure's number.  Keep a word before the number, and keep %d as
#. * it is: the captions already there are counted by what comes before
#. * it.
#: src/ui/w42-window.c:3583 src/ui/w42-window.c:3599
#, c-format
msgid "Figure %d: "
msgstr "Рисунок %d: "

#: src/ui/w42-window.c:3662
msgid "Put the caret at a note's mark, or in the note itself."
msgstr "Поместите курсор на знак сноски или в саму сноску."

#: src/ui/w42-window.c:3744
msgid "No thesaurus was found."
msgstr "Тезаурус не найден."

#: src/ui/w42-window.c:3745
msgid ""
"The thesaurus needs a MyThes file for the language of the text -- "
"th_en_US_v2.dat and its .idx for English, th_nb_NO_v2 for Norwegian, the "
"ones LibreOffice uses -- in the mythes folder."
msgstr ""
"Для тезауруса нужен файл MyThes для языка текста -- th_en_US_v2.dat и его ."
"idx для английского, th_nb_NO_v2 для норвежского, те же, что использует "
"LibreOffice, -- в папке mythes."

#: src/ui/w42-window.c:3752
msgid "Put the caret in a word to look it up in the thesaurus."
msgstr "Поместите курсор в слово, чтобы найти его в тезаурусе."

#: src/ui/w42-window.c:3764
msgid "No spelling dictionary was found."
msgstr "Словарь для проверки орфографии не найден."

#: src/ui/w42-window.c:3765
msgid "Install a Hunspell dictionary for your language and start Word42 again."
msgstr "Установите словарь Hunspell для вашего языка и перезапустите Word42."

#: src/ui/w42-window.c:3818
msgid "Revisions accepted."
msgstr "Исправления приняты."

#: src/ui/w42-window.c:3820 src/ui/w42-window.c:3832
msgid "There are no revision marks in this document."
msgstr "В документе нет исправлений."

#: src/ui/w42-window.c:3830
msgid "Revisions rejected."
msgstr "Исправления отклонены."

#. Translators: the Windows version in the About box, as "Windows
#. * 10.0 build 19045 (Windows 10)": the major and minor version, the
#. * build number, then the release's name in brackets or nothing.
#: src/ui/w42-window.c:3943
#, c-format
msgid "Windows %lu.%lu build %lu%s"
msgstr "Windows %lu.%lu сборка %lu%s"

#. Translators: what the About box says this copy runs on, for bug
#. * reports.  The version numbers and library names fill the
#. * placeholders in turn: Word42's version; GTK's running version and
#. * the one built against; GLib's; Pango's, Cairo's and GdkPixbuf's;
#. * the operating system; then the spelling, hyphenation and PDF
#. * import libraries, or "none".
#: src/ui/w42-window.c:3974
#, c-format
msgid ""
"Word42 %s\n"
"GTK %u.%u.%u (built against %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"Spelling: %s  ·  Hyphenation: %s  ·  PDF import: %s"
msgstr ""
"Word42 %s\n"
"GTK %u.%u.%u (собрано с %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"Орфография: %s  ·  Переносы: %s  ·  Импорт PDF: %s"

#. Translators: no library for this, in the About box.
#: src/ui/w42-window.c:3989 src/ui/w42-window.c:3995 src/ui/w42-window.c:4001
msgctxt "library"
msgid "none"
msgstr "нет"

#: src/ui/w42-window.c:4033
msgid "About Word42"
msgstr "О программе Word42"

#. Translators: %s is Word42's version number.
#: src/ui/w42-window.c:4056
#, c-format
msgid "Version %s"
msgstr "Версия %s"

#: src/ui/w42-window.c:4067
msgid "Written in C on GTK 4, Pango and Cairo."
msgstr "Написано на C с использованием GTK 4, Pango и Cairo."

