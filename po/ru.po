msgstr "Отменить"

#: src/ui/w42-window.c:4573
msgid "Redo"
msgstr "Вернуть"

#: src/ui/w42-window.c:4576
msgid "Show as Slide Show"
msgstr "Показать как слайд-шоу"

#: src/ui/w42-window.c:4597
msgid "Zoom Control"
msgstr "Масштаб"

#: src/ui/w42-window.c:4952
msgid "Font Color"
msgstr "Цвет шрифта"

#: src/ui/w42-window.c:5024
msgid "Align Left"
msgstr "По левому краю"

#: src/ui/w42-window.c:5027
msgid "Align Right"
msgstr "По правому краю"

#: src/ui/w42-window.c:5027
msgid "Justify"
msgstr "По ширине"

#: src/ui/w42-window.c:5080
msgid "Font Size"
msgstr "Размер шрифта"

#: src/ui/w42-window.c:5087
msgid "Bold"
msgstr "Полужирный"

#: src/ui/w42-window.c:5088
msgid "Italic"
msgstr "Курсив"

#: src/ui/w42-window.c:5117
msgid "Bullets"
msgstr "Маркеры"

#. Translators: the status bar's page number.
#: src/ui/w42-window.c:5148 src/ui/w42-window.c:5984
#, c-format
msgid "Page %d"
msgstr "Стр. %d"

#. Translators: the status bar's reading of how far down the page
#. * the caret is, "At" short for "at so far from the top": %.1f is
#. * the distance, %s the unit, already translated (" or cm).
#: src/ui/w42-window.c:5150 src/ui/w42-window.c:6010
#, c-format
msgid "At %.1f%s"
msgstr "На %.1f%s"

#. Translators: the status bar's line number, "Ln" short for Line.
#: src/ui/w42-window.c:5152 src/ui/w42-window.c:5992
#, c-format
msgid "Ln %d"
msgstr "Ст %d"

#. Translators: the status bar's column number, "Col" short for
#. * Column: how many characters in from the start of the line.
#: src/ui/w42-window.c:5154 src/ui/w42-window.c:5996
#, c-format
msgid "Col %d"
msgstr "Кол %d"

#. Translators: the status bar's word count toward the goal set in
#. * Tools > Word Count Goal: "12,000 of 80,000 words".  The first %s
#. * is the words written, the second the goal.
#: src/ui/w42-window.c:5257
#, c-format
msgid "%s of %s word"
msgid_plural "%s of %s words"
msgstr[0] "%s из %s слова"
msgstr[1] "%s из %s слов"
msgstr[2] "%s из %s слов"

#. Translators: the status bar's word count; %s is the number, with
#. * thousands separators.
#: src/ui/w42-window.c:5265
#, c-format
msgid "%s word"
msgid_plural "%s words"
msgstr[0] "%s слово"
msgstr[1] "%s слова"
msgstr[2] "%s слов"

#. Translators: in the word count's tooltip; %d%% is how far
#. * toward the goal the document is, as "40%".
#: src/ui/w42-window.c:5276
#, c-format
msgid "%d%% of the goal."
msgstr "%d%% от цели."

#. Translators: in the word count's tooltip; %ld is the words
#. * written since the document was opened, which can be less than
#. * nothing when more was deleted.
#: src/ui/w42-window.c:5287
#, c-format
msgid "Written since the document was opened: %ld word."
msgid_plural "Written since the document was opened: %ld words."
msgstr[0] "Написано с момента открытия документа: %ld слово."
msgstr[1] "Написано с момента открытия документа: %ld слова."
msgstr[2] "Написано с момента открытия документа: %ld слов."

#: src/ui/w42-window.c:5293
msgid "Tools ▸ Word Count Goal sets the goal."
msgstr "Цель задается командой Сервис ▸ Целевое число слов."

#: src/ui/w42-window.c:5558
msgid "The rest are saved."
msgstr "Остальные документы сохранены."

#: src/ui/w42-window.c:5558
msgid "Nothing was saved."
msgstr "Ничего не сохранено."

#: src/ui/w42-window.c:5559
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"Документу, который ни разу не сохранялся или открыт из формата, в котором "
"Word42 не сохраняет, нужно имя: воспользуйтесь командой Файл > Сохранить как."

#: src/ui/w42-window.c:5598 src/ui/w42-window.c:5640
msgid "Word42 could not read that file."
msgstr "Word42 не удалось прочитать этот файл."

#: src/ui/w42-window.c:5634
msgid "The two documents are the same."
msgstr "Документы совпадают."

#: src/ui/w42-window.c:5636
#, c-format
msgid "%d change marked."
msgid_plural "%d changes marked."
msgstr[0] "Отмечено %d исправление."
msgstr[1] "Отмечено %d исправления."
msgstr[2] "Отмечено %d исправлений."

#: src/ui/w42-window.c:5660
msgid "Compare Documents: the original"
msgstr "Сравнение документов: исходный документ"

#: src/ui/w42-window.c:5676
msgid "Insert File"
msgstr "Вставка файла"

#: src/ui/w42-window.c:6019
msgid "Modified"
msgstr "Изменен"

#: src/util/w42-image.c:153
#, c-format
msgid "That file is not a picture in any format Word42 can read."
msgstr ""
"Этот файл не является рисунком ни в одном из форматов, которые может "
"прочитать Word42."

#. Translators: the language of text that is not to be spell-checked
#. * at all, as Tools > Language lists it.
#: src/util/w42-lang.c:21
msgid "(no proofing)"
msgstr "(без проверки)"

