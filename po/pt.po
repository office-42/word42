msgstr "Negrito"

#: src/ui/w42-window.c:5215
msgid "Italic"
msgstr "Itálico"

#: src/ui/w42-window.c:5244
msgid "Bullets"
msgstr "Marcadores"

#. Translators: the status bar's page number.
#: src/ui/w42-window.c:5275 src/ui/w42-window.c:6111
#, c-format
msgid "Page %d"
msgstr "Pág %d"

#. Translators: the status bar's reading of how far down the page
#. * the caret is, "At" short for "at so far from the top": %.1f is
#. * the distance, %s the unit, already translated (" or cm).
#: src/ui/w42-window.c:5277 src/ui/w42-window.c:6137
#, c-format
msgid "At %.1f%s"
msgstr "Em %.1f%s"

#. Translators: the status bar's line number, "Ln" short for Line.
#: src/ui/w42-window.c:5279 src/ui/w42-window.c:6119
#, c-format
msgid "Ln %d"
msgstr "Lin %d"

#. Translators: the status bar's column number, "Col" short for
#. * Column: how many characters in from the start of the line.
#: src/ui/w42-window.c:5281 src/ui/w42-window.c:6123
#, c-format
msgid "Col %d"
msgstr "Col %d"

#. Translators: the status bar's word count toward the goal set in
#. * Tools > Word Count Goal: "12,000 of 80,000 words".  The first %s
#. * is the words written, the second the goal.
#: src/ui/w42-window.c:5384
#, c-format
msgid "%s of %s word"
msgid_plural "%s of %s words"
msgstr[0] "%s de %s palavra"
msgstr[1] "%s de %s palavras"

#. Translators: the status bar's word count; %s is the number, with
#. * thousands separators.
#: src/ui/w42-window.c:5392
#, c-format
msgid "%s word"
msgid_plural "%s words"
msgstr[0] "%s palavra"
msgstr[1] "%s palavras"

#. Translators: in the word count's tooltip; %d%% is how far
#. * toward the goal the document is, as "40%".
#: src/ui/w42-window.c:5403
#, c-format
msgid "%d%% of the goal."
msgstr "%d%% da meta."

#. Translators: in the word count's tooltip; %ld is the words
#. * written since the document was opened, which can be less than
#. * nothing when more was deleted.
#: src/ui/w42-window.c:5414
#, c-format
msgid "Written since the document was opened: %ld word."
msgid_plural "Written since the document was opened: %ld words."
msgstr[0] "Palavras escritas desde que o documento foi aberto: %ld."
msgstr[1] "Palavras escritas desde que o documento foi aberto: %ld."

#: src/ui/w42-window.c:5420
msgid "Tools ▸ Word Count Goal sets the goal."
msgstr "Ferramentas ▸ Meta de contagem de palavras define a meta."

#: src/ui/w42-window.c:5685
msgid "The rest are saved."
msgstr "Os demais foram salvos."

#: src/ui/w42-window.c:5685
msgid "Nothing was saved."
msgstr "Nada foi salvo."

#: src/ui/w42-window.c:5686
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"Um documento que nunca foi salvo, ou que veio de um formato que o Word42 não "
"grava de volta, precisa de um nome: use Arquivo > Salvar como para ele."

#: src/ui/w42-window.c:5725 src/ui/w42-window.c:5767
msgid "Word42 could not read that file."
msgstr "O Word42 não pôde ler esse arquivo."

#: src/ui/w42-window.c:5761
msgid "The two documents are the same."
msgstr "Os dois documentos são iguais."

#: src/ui/w42-window.c:5763
#, c-format
msgid "%d change marked."
msgid_plural "%d changes marked."
msgstr[0] "%d alteração marcada."
msgstr[1] "%d alterações marcadas."

#: src/ui/w42-window.c:5787
msgid "Compare Documents: the original"
msgstr "Comparar documentos: o original"

#: src/ui/w42-window.c:5803
msgid "Insert File"
msgstr "Inserir arquivo"

#: src/ui/w42-window.c:6146
msgid "Modified"
msgstr "Modificado"

#: src/util/w42-image.c:153
#, c-format
msgid "That file is not a picture in any format Word42 can read."
msgstr ""
"Esse arquivo não é uma imagem em nenhum formato que o Word42 consiga ler."

