#. Translators: %s says what the fault is.
#: src/io/w42-abw.c:1640
#, c-format
msgid "The compressed AbiWord file is damaged: %s"
msgstr "O arquivo compactado do AbiWord está danificado: %s"

#: src/io/w42-abw.c:1648
msgid "The compressed AbiWord file unpacks to more than 256 MB."
msgstr ""
"O arquivo compactado do AbiWord ocupa mais de 256 MB ao ser descompactado."

#: src/io/w42-abw.c:1665
msgid "The compressed AbiWord file is cut short."
msgstr "O arquivo compactado do AbiWord está truncado."

#: src/io/w42-abw.c:2959
msgid "The document could not be compressed."
msgstr "Não foi possível compactar o documento."

#. Translators: OLE is the container a Word 97 file is kept in,
#. * made of numbered sectors; %u is a sector's number.
#: src/io/w42-doc.c:133
#, c-format
msgid "OLE sector %u is past the end of the file"
msgstr "O setor OLE %u está além do fim do arquivo"

#. Translators: OLE is the container a Word 97 file is kept in,
#. * FAT its table of sectors; %u is a sector's number.
#: src/io/w42-doc.c:137
#, c-format
msgid "OLE sector %u has no FAT entry"
msgstr "O setor OLE %u não tem entrada na FAT"

#: src/io/w42-doc.c:139
msgid "OLE sector chain loops"
msgstr "A cadeia de setores OLE forma um ciclo"

#: src/io/w42-doc.c:172
msgid "This is not a Word document (no OLE2 header)."
msgstr "Este não é um documento do Word (sem cabeçalho OLE2)."

#: src/io/w42-doc.c:185
msgid "OLE sector size is out of range"
msgstr "O tamanho do setor OLE está fora do intervalo"

#: src/io/w42-doc.c:259
msgid "OLE directory is empty"
msgstr "O diretório OLE está vazio"

#. Translators: %s is the name of a part of a
#. * Word 97 file, such as "WordDocument".
#: src/io/w42-doc.c:354
#, c-format
msgid "OLE mini stream %s is damaged"
msgstr "O minifluxo OLE %s está danificado"

#. Translators: %s is the name of a part of a Word 97 file,
#. * such as "WordDocument" or "1Table".
#: src/io/w42-doc.c:376
#, c-format
msgid "The document has no %s stream."
msgstr "O documento não tem o fluxo %s."

#: src/io/w42-doc.c:538
msgid "The document has no piece table."
msgstr "O documento não tem tabela de partes."

#: src/io/w42-doc.c:546 src/io/w42-doc.c:550 src/io/w42-doc.c:555
msgid "Piece table is damaged"
msgstr "A tabela de partes está danificada"

#: src/io/w42-doc.c:602
msgid "The document has no text pieces."
msgstr "O documento não tem partes de texto."

#: src/io/w42-doc.c:3792
msgid "The document's text is out of reach."
msgstr "O texto do documento está fora dos limites do arquivo."

#. Translators: WordDocument is the name of the part of
#. * a Word 97 file that holds its text; keep it as it is.
#: src/io/w42-doc.c:3854
#, c-format
msgid "The WordDocument stream is too short to be one."
msgstr "O fluxo WordDocument é curto demais para ser válido."

#: src/io/w42-doc.c:3864
#, c-format
msgid "This is not a Word document."
msgstr "Este não é um documento do Word."

#: src/io/w42-doc.c:3876
#, c-format
msgid "The document is encrypted, and Word42 cannot open encrypted documents."
msgstr ""
"O documento está criptografado, e o Word42 não pode abrir documentos "
"criptografados."

#. Translators: word/document.xml is the name of a file
#. * inside a .docx; keep it as it is.
#: src/io/w42-docx.c:4076
#, c-format
msgid "The file is not a Word document: it has no word/document.xml."
msgstr "O arquivo não é um documento do Word: não contém word/document.xml."

#: src/io/w42-git.c:45 src/ui/w42-versions.c:683
msgid ""
"This Word42 was built without Git (libgit2), so it cannot keep versions of a "
"document."
msgstr ""
"Este Word42 foi compilado sem Git (libgit2), por isso não pode guardar "
"versões de um documento."

#: src/io/w42-git.c:134
msgid "Git could not do what was asked."
msgstr "O Git não pôde fazer o que foi pedido."

#: src/io/w42-git.c:221
msgid "Versions are kept only of a document saved on this computer."
msgstr "Só são guardadas versões de um documento salvo neste computador."

#: src/io/w42-git.c:245
msgid ""
"The document's folder is in a Git repository that has no working folder, so "
"Word42 cannot keep versions in it."
msgstr ""
"A pasta do documento está em um repositório Git sem pasta de trabalho, por "
"isso o Word42 não pode guardar versões nele."

#: src/io/w42-git.c:257
msgid "Word42 could not find the document inside its Git repository."
