msgstr "Word42 के बारे में(_A)"

#. Translators: %s says what the fault is.
#: src/io/w42-abw.c:1623
#, c-format
msgid "The compressed AbiWord file is damaged: %s"
msgstr "संपीड़ित AbiWord फ़ाइल क्षतिग्रस्त है: %s"

#: src/io/w42-abw.c:1631
msgid "The compressed AbiWord file unpacks to more than 256 MB."
msgstr "संपीड़ित AbiWord फ़ाइल खोलने पर 256 MB से अधिक हो जाती है।"

#: src/io/w42-abw.c:1648
msgid "The compressed AbiWord file is cut short."
msgstr "संपीड़ित AbiWord फ़ाइल अधूरी है।"

#: src/io/w42-abw.c:2928
msgid "The document could not be compressed."
msgstr "दस्तावेज़ को संपीड़ित नहीं किया जा सका।"

#. Translators: OLE is the container a Word 97 file is kept in,
#. * made of numbered sectors; %u is a sector's number.
#: src/io/w42-doc.c:131
#, c-format
msgid "OLE sector %u is past the end of the file"
msgstr "OLE सेक्टर %u फ़ाइल के अंत से आगे है"

#. Translators: OLE is the container a Word 97 file is kept in,
#. * FAT its table of sectors; %u is a sector's number.
#: src/io/w42-doc.c:135
#, c-format
msgid "OLE sector %u has no FAT entry"
msgstr "OLE सेक्टर %u की कोई FAT प्रविष्टि नहीं है"

#: src/io/w42-doc.c:137
msgid "OLE sector chain loops"
msgstr "OLE सेक्टर शृंखला एक लूप में घूमती है"

#: src/io/w42-doc.c:170
msgid "This is not a Word document (no OLE2 header)."
msgstr "यह Word दस्तावेज़ नहीं है (कोई OLE2 हेडर नहीं)।"

#: src/io/w42-doc.c:183
msgid "OLE sector size is out of range"
msgstr "OLE सेक्टर आकार सीमा से बाहर है"

#: src/io/w42-doc.c:257
msgid "OLE directory is empty"
msgstr "OLE निर्देशिका रिक्त है"

#. Translators: %s is the name of a part of a
#. * Word 97 file, such as "WordDocument".
#: src/io/w42-doc.c:352
#, c-format
msgid "OLE mini stream %s is damaged"
msgstr "OLE मिनी स्ट्रीम %s क्षतिग्रस्त है"

#. Translators: %s is the name of a part of a Word 97 file,
#. * such as "WordDocument" or "1Table".
#: src/io/w42-doc.c:374
#, c-format
msgid "The document has no %s stream."
msgstr "दस्तावेज़ में कोई %s स्ट्रीम नहीं है।"

#: src/io/w42-doc.c:525
msgid "The document has no piece table."
msgstr "दस्तावेज़ में कोई पीस तालिका नहीं है।"

#: src/io/w42-doc.c:533 src/io/w42-doc.c:537 src/io/w42-doc.c:542
msgid "Piece table is damaged"
msgstr "पीस तालिका क्षतिग्रस्त है"

#: src/io/w42-doc.c:589
msgid "The document has no text pieces."
msgstr "दस्तावेज़ में कोई पाठ खंड नहीं हैं।"

#: src/io/w42-doc.c:3160
msgid "The document's text is out of reach."
msgstr "दस्तावेज़ का पाठ पहुँच से बाहर है।"

#. Translators: WordDocument is the name of the part of
#. * a Word 97 file that holds its text; keep it as it is.
#: src/io/w42-doc.c:3222
#, c-format
msgid "The WordDocument stream is too short to be one."
msgstr "WordDocument स्ट्रीम इतनी छोटी है कि वह वैध नहीं हो सकती।"

#: src/io/w42-doc.c:3232
#, c-format
msgid "This is not a Word document."
msgstr "यह Word दस्तावेज़ नहीं है।"

#: src/io/w42-doc.c:3244
#, c-format
msgid "The document is encrypted, and Word42 cannot open encrypted documents."
msgstr "दस्तावेज़ एन्क्रिप्टेड है, और Word42 एन्क्रिप्टेड दस्तावेज़ नहीं खोल सकता।"

#. Translators: word/document.xml is the name of a file
#. * inside a .docx; keep it as it is.
#: src/io/w42-docx.c:4023
#, c-format
msgid "The file is not a Word document: it has no word/document.xml."
msgstr "फ़ाइल Word दस्तावेज़ नहीं है: इसमें word/document.xml नहीं है।"

#. Translators: "the page" is the web page (HTML file)
#. * being opened.
#: src/io/w42-htmlin.c:3570
#, c-format
msgid "The page nests its elements too deeply to be a document."
msgstr "पृष्ठ के तत्व इतनी गहराई तक नेस्ट किए गए हैं कि इसे दस्तावेज़ नहीं माना जा सकता।"

#. Translators: "the page" is the web page (HTML file)
#. * being opened.
#: src/io/w42-htmlin.c:3584
#, c-format
msgid "The page could not be parsed."
msgstr "पृष्ठ को पार्स नहीं किया जा सका।"

#: src/io/w42-io.c:224
#, c-format
msgid "Word42 writes EPUB but does not read it."
msgstr "Word42 EPUB लिखता है, लेकिन उसे पढ़ता नहीं है।"

#: src/io/w42-io.c:274
#, c-format
msgid "The file is not text in any encoding Word42 recognises."
msgstr "फ़ाइल किसी भी ऐसे एन्कोडिंग में पाठ नहीं है जिसे Word42 पहचानता हो।"

#: src/io/w42-io.c:316
#, c-format
msgid ""
"Word42 reads Word .doc files but does not write them. Save as RTF or .docx, "
"which other word processors read."
msgstr ""
"Word42 Word .doc फ़ाइलें पढ़ता है, लेकिन उन्हें लिखता नहीं है। RTF या .docx के रूप में सहेजें, "
"जिन्हें अन्य वर्ड प्रोसेसर पढ़ते हैं।"

#: src/io/w42-merge.c:166
#, c-format
msgid "The data source has no field names in its first row."
msgstr "डेटा स्रोत की पहली पंक्ति में कोई फ़ील्ड नाम नहीं हैं।"

#: src/io/w42-merge.c:216 src/io/w42-merge.c:231
#, c-format
msgid "Could not make a temporary file."
msgstr "अस्थायी फ़ाइल नहीं बनाई जा सकी।"

#. Translators: content.xml is the name of a file inside
#. * an .odt; keep it as it is.
#: src/io/w42-odt.c:2655
#, c-format
msgid "The file is not an OpenDocument text: it has no content.xml."
msgstr "फ़ाइल OpenDocument पाठ नहीं है: इसमें content.xml नहीं है।"

#. Translators: %s is the reason, as the Cairo graphics
#. * library gives it, in English.
#: src/io/w42-pdf.c:209 src/io/w42-pdf.c:224
#, c-format
msgid "Word42 could not write the PDF: %s"
msgstr "Word42 PDF नहीं लिख सका: %s"

#. Translators: poppler is the name of a program library;
#. * keep it as it is.
#: src/io/w42-pdf.c:995
#, c-format
msgid ""
"This build of Word42 cannot read PDF files. It was built without poppler."
msgstr ""
"Word42 का यह बिल्ड PDF फ़ाइलें नहीं पढ़ सकता। इसे poppler के बिना बनाया गया था।"

#. Translators: ppt/presentation.xml is the name of a file
#. * inside a .pptx; keep it as it is.
#: src/io/w42-pptx.c:679
#, c-format
msgid "That file is not a presentation: it has no ppt/presentation.xml."
msgstr "वह फ़ाइल प्रस्तुति नहीं है: इसमें ppt/presentation.xml नहीं है।"

#. Translators: the heading given to a slide that has no
#. * title of its own, when a presentation is opened.
#: src/io/w42-pptx.c:736
msgid "Slide"
msgstr "स्लाइड"

#: src/io/w42-rtf.c:3872
#, c-format
msgid "That file does not begin like an RTF document."
msgstr "वह फ़ाइल RTF दस्तावेज़ की तरह शुरू नहीं होती।"

#: src/io/w42-zip.c:166 src/io/w42-zip.c:182
#, c-format
msgid "Not a zip file."
msgstr "zip फ़ाइल नहीं है।"

#: src/io/w42-zip.c:193
#, c-format
msgid "The zip file is cut short."
msgstr "zip फ़ाइल अधूरी है।"

#. Translators: %d is a line of the macro, %s what is wrong with it.
#: src/macro/w42-vba.c:276 src/ui/w42-macro.c:2789
#, c-format
msgid "Line %d: %s"
msgstr "पंक्ति %d: %s"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:593
msgid "a name starting with a dot needs a With block"
msgstr "बिंदु से शुरू होने वाले नाम के लिए With ब्लॉक आवश्यक है"

#: src/macro/w42-vba.c:812
msgid "a named argument outside a call"
msgstr "कॉल के बाहर नामित तर्क"

#. Translators: Sub and Function are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:875
msgid "Sub or Function without a name"
msgstr "बिना नाम का Sub या Function"

#. Translators: "Optional" is a macro keyword: keep it in
#. * English.
#: src/macro/w42-vba.c:913
msgid "an Optional parameter with a default value is not supported"
msgstr "डिफ़ॉल्ट मान वाला Optional पैरामीटर समर्थित नहीं है"

#. Translators: "Dim" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:941
msgid "Dim expects a name"
msgstr "Dim के बाद नाम अपेक्षित है"

#. Translators: "New" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:960
msgid "objects made with New are not supported"
msgstr "New से बनाए गए ऑब्जेक्ट समर्थित नहीं हैं"

#. Translators: "Dim a(10)" is macro code: keep it as it
#. * is.
#: src/macro/w42-vba.c:998
msgid "an array's size must be a number: Dim a(10)"
msgstr "सरणी का आकार एक संख्या होना चाहिए: Dim a(10)"

#. Translators: End Sub, Sub, End Function and Function
#. * are macro keywords: keep them in English.
#: src/macro/w42-vba.c:1150
msgid "End Sub without Sub"
msgstr "Sub के बिना End Sub"

#: src/macro/w42-vba.c:1151
msgid "End Function without Function"
msgstr "Function के बिना End Function"

#. Translators: the first %s is a macro keyword (Sub,
#. * Function, If, For, Do, Select Case or With), the
#. * second Sub or Function; "End" is a keyword too.  Keep
#. * them all in English.
#: src/macro/w42-vba.c:1160
#, c-format
msgid "%s is still open at End %s"
msgstr "End %2$s पर %1$s अभी भी खुला है"

#. Translators: End If and If are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1177
msgid "End If without If"
msgstr "If के बिना End If"

#. Translators: End Select and Select are macro keywords:
#. * keep them in English.
#: src/macro/w42-vba.c:1185
msgid "End Select without Select"
msgstr "Select के बिना End Select"

#. Translators: End With and With are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1193
msgid "End With without With"
msgstr "With के बिना End With"

#. Translators: "End" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1198
msgid "End of what?"
msgstr "End किसका?"

#. Translators: "Exit" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1216
msgid "Exit of what?"
msgstr "Exit किससे?"

#. Translators: If and Then are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1228
msgid "If without Then"
msgstr "Then के बिना If"

#. Translators: Select and Case are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1289
msgid "Select without Case"
msgstr "Case के बिना Select"

#. Translators: Case and Select Case are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1308
msgid "Case outside Select Case"
msgstr "Select Case के बाहर Case"

#. Translators: "For Each" is a macro keyword, and "For i = 1
#. * To ...Count" macro code: keep them in English.
#: src/macro/w42-vba.c:1331
msgid "For Each is not supported: count with For i = 1 To ...Count"
msgstr "For Each समर्थित नहीं है: For i = 1 To ...Count से गिनें"

#. Translators: "For" is a macro keyword, and "For i = a To
#. * b" macro code: keep them in English.
#: src/macro/w42-vba.c:1344
msgid "For expects: For i = a To b"
msgstr "For का अपेक्षित रूप: For i = a To b"

#. Translators: Next and For are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1369
msgid "Next without For"
msgstr "For के बिना Next"

#. Translators: Wend and While are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1414
msgid "Wend without While"
msgstr "While के बिना Wend"

#. Translators: Loop and Do are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1427
msgid "Loop without Do"
msgstr "Do के बिना Loop"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1463
msgid "With without an object"
msgstr "ऑब्जेक्ट के बिना With"

#. Translators: "Const" is a macro keyword: keep it in English.
#. * NAME and value stand for what is written there.
#: src/macro/w42-vba.c:1497
msgid "Const expects NAME = value"
msgstr "Const के बाद नाम = मान अपेक्षित है"

#. Translators: "GoTo" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1514
msgid "GoTo and labels are not supported"
msgstr "GoTo और लेबल समर्थित नहीं हैं"

#: src/macro/w42-vba.c:1559
msgid "an indexed object property cannot be set"
msgstr "अनुक्रमित ऑब्जेक्ट गुण सेट नहीं किया जा सकता"

#: src/macro/w42-vba.c:1592
msgid "a statement that does not start with a name"
msgstr "ऐसा कथन जो किसी नाम से शुरू नहीं होता"

#: src/macro/w42-vba.c:1770
msgid "labels are not supported"
msgstr "लेबल समर्थित नहीं हैं"

#. Translators: %s is a macro keyword (Sub, Function, If, For, Do,
#. * Select Case or With): keep it in English.
#: src/macro/w42-vba.c:1803
#, c-format
msgid "%s is never ended"
msgstr "%s कभी समाप्त नहीं किया गया"

#. Translators: "Sub" is a macro keyword: keep it in English.
#. * %s is the Sub's name.
#: src/macro/w42-vba.c:1820
#, c-format
msgid "There is no Sub named %s in this macro."
msgstr "इस मैक्रो में %s नाम का कोई Sub नहीं है।"

#: src/main.c:115
msgid "Usage: word42 --convert-to=FORMAT [--outdir=DIR] FILE..."
msgstr "उपयोग: word42 --convert-to=FORMAT [--outdir=DIR] FILE..."

#: src/main.c:116
msgid ""
"FORMAT is the extension to write: pdf, epub, odt, docx, rtf, html, txt or "
"abw."
msgstr ""
"FORMAT लिखे जाने वाले प्रारूप का एक्सटेंशन है: pdf, epub, odt, docx, rtf, html, txt "
"या abw।"

#: src/main.c:126
msgid "the folder could not be made"
msgstr "फ़ोल्डर नहीं बनाया जा सका"

#: src/main.c:159
msgid "already in that format"
msgstr "पहले से उस प्रारूप में है"

#: src/main.c:169
msgid "could not be converted"
msgstr "कनवर्ट नहीं किया जा सका"

#. Translators: the name of a new document not yet saved, shown in
#. * the title bar and also used as its file name, so the translation
#. * must be usable as one: no dots, slashes, backslashes, colons or
