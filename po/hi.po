msgstr "उपकरण ▸ शब्द गणना लक्ष्य से लक्ष्य सेट होता है।"

#: src/ui/w42-window.c:5558
msgid "The rest are saved."
msgstr "बाकी सहेज दिए गए हैं।"

#: src/ui/w42-window.c:5558
msgid "Nothing was saved."
msgstr "कुछ भी सहेजा नहीं गया।"

#: src/ui/w42-window.c:5559
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"जो दस्तावेज़ कभी सहेजा नहीं गया है, या ऐसे प्रारूप से आया है जिसे Word42 वापस नहीं लिखता, "
"उसे एक नाम चाहिए: उसके लिए फ़ाइल > इस रूप में सहेजें का उपयोग करें।"

#: src/ui/w42-window.c:5598 src/ui/w42-window.c:5640
msgid "Word42 could not read that file."
msgstr "Word42 वह फ़ाइल नहीं पढ़ सका।"

#: src/ui/w42-window.c:5634
msgid "The two documents are the same."
msgstr "दोनों दस्तावेज़ एक जैसे हैं।"

#: src/ui/w42-window.c:5636
#, c-format
msgid "%d change marked."
msgid_plural "%d changes marked."
msgstr[0] "%d परिवर्तन चिह्नित किया गया।"
msgstr[1] "%d परिवर्तन चिह्नित किए गए।"

#: src/ui/w42-window.c:5660
msgid "Compare Documents: the original"
msgstr "दस्तावेज़ों की तुलना करें: मूल दस्तावेज़"

