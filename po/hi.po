msgid "Surname / TITLE"
msgstr "उपनाम / शीर्षक"

#: src/model/w42-template.c:401
msgid "Your Email and Telephone"
msgstr "आपका ईमेल और टेलीफ़ोन"

#: src/model/w42-template.c:404
msgid "THE TITLE"
msgstr "शीर्षक"

#: src/model/w42-template.c:405
msgid "by Your Name"
msgstr "लेखक: आपका नाम"

