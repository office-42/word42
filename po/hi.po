#, c-format
msgid ""
"Word42 %s\n"
"GTK %u.%u.%u (built against %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"Spelling: %s  ·  Hyphenation: %s  ·  PDF import: %s"
msgstr ""
"Word42 %s\n"
"GTK %u.%u.%u (%d.%d.%d के लिए बिल्ड किया गया)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"वर्तनी: %s  ·  हायफ़नेशन: %s  ·  PDF आयात: %s"

