#, c-format
msgid "Written since the document was opened: %ld word."
msgid_plural "Written since the document was opened: %ld words."
msgstr[0] "दस्तावेज़ खोलने के बाद लिखे गए: %ld शब्द।"
msgstr[1] "दस्तावेज़ खोलने के बाद लिखे गए: %ld शब्द।"

#: src/ui/w42-window.c:5293
