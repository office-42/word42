#, c-format
msgid "Line %d: %s"
msgstr "第 %d 行：%s"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:593
msgid "a name starting with a dot needs a With block"
msgstr "以点开头的名称必须位于 With 块中"

#: src/macro/w42-vba.c:812
msgid "a named argument outside a call"
msgstr "命名参数位于调用之外"

#. Translators: Sub and Function are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:875
msgid "Sub or Function without a name"
msgstr "Sub 或 Function 没有名称"

#. Translators: "Optional" is a macro keyword: keep it in
#. * English.
#: src/macro/w42-vba.c:913
msgid "an Optional parameter with a default value is not supported"
msgstr "不支持带默认值的 Optional 参数"

#. Translators: "Dim" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:941
msgid "Dim expects a name"
msgstr "Dim 后面应为名称"

#. Translators: "New" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:960
msgid "objects made with New are not supported"
msgstr "不支持用 New 创建的对象"

#. Translators: "Dim a(10)" is macro code: keep it as it
#. * is.
#: src/macro/w42-vba.c:998
msgid "an array's size must be a number: Dim a(10)"
msgstr "数组的大小必须是数字：Dim a(10)"

#. Translators: End Sub, Sub, End Function and Function
#. * are macro keywords: keep them in English.
#: src/macro/w42-vba.c:1150
msgid "End Sub without Sub"
msgstr "End Sub 没有对应的 Sub"

#: src/macro/w42-vba.c:1151
msgid "End Function without Function"
msgstr "End Function 没有对应的 Function"

#. Translators: the first %s is a macro keyword (Sub,
#. * Function, If, For, Do, Select Case or With), the
#. * second Sub or Function; "End" is a keyword too.  Keep
#. * them all in English.
#: src/macro/w42-vba.c:1160
#, c-format
msgid "%s is still open at End %s"
msgstr "%s 在 End %s 处仍未结束"

#. Translators: End If and If are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1177
msgid "End If without If"
msgstr "End If 没有对应的 If"

#. Translators: End Select and Select are macro keywords:
#. * keep them in English.
#: src/macro/w42-vba.c:1185
msgid "End Select without Select"
msgstr "End Select 没有对应的 Select"

#. Translators: End With and With are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1193
msgid "End With without With"
msgstr "End With 没有对应的 With"

#. Translators: "End" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1198
msgid "End of what?"
msgstr "End 要结束什么？"

#. Translators: "Exit" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1216
msgid "Exit of what?"
msgstr "Exit 要退出什么？"

#. Translators: If and Then are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1228
msgid "If without Then"
msgstr "If 缺少 Then"

#. Translators: Select and Case are macro keywords: keep them
#. * in English.
#: src/macro/w42-vba.c:1289
msgid "Select without Case"
msgstr "Select 缺少 Case"

#. Translators: Case and Select Case are macro keywords: keep
#. * them in English.
#: src/macro/w42-vba.c:1308
msgid "Case outside Select Case"
msgstr "Case 位于 Select Case 之外"

#. Translators: "For Each" is a macro keyword, and "For i = 1
#. * To ...Count" macro code: keep them in English.
#: src/macro/w42-vba.c:1331
msgid "For Each is not supported: count with For i = 1 To ...Count"
msgstr "不支持 For Each：请用 For i = 1 To ...Count 计数"

#. Translators: "For" is a macro keyword, and "For i = a To
#. * b" macro code: keep them in English.
#: src/macro/w42-vba.c:1344
msgid "For expects: For i = a To b"
msgstr "For 的格式应为：For i = a To b"

#. Translators: Next and For are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1369
msgid "Next without For"
msgstr "Next 没有对应的 For"

#. Translators: Wend and While are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1414
msgid "Wend without While"
msgstr "Wend 没有对应的 While"

#. Translators: Loop and Do are macro keywords: keep them in
#. * English.
#: src/macro/w42-vba.c:1427
msgid "Loop without Do"
msgstr "Loop 没有对应的 Do"

#. Translators: "With" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1463
msgid "With without an object"
msgstr "With 缺少对象"

#. Translators: "Const" is a macro keyword: keep it in English.
#. * NAME and value stand for what is written there.
#: src/macro/w42-vba.c:1497
msgid "Const expects NAME = value"
msgstr "Const 的格式应为：名称 = 值"

#. Translators: "GoTo" is a macro keyword: keep it in English.
#: src/macro/w42-vba.c:1514
msgid "GoTo and labels are not supported"
msgstr "不支持 GoTo 和标签"

#: src/macro/w42-vba.c:1559
msgid "an indexed object property cannot be set"
msgstr "无法设置带索引的对象属性"

#: src/macro/w42-vba.c:1592
msgid "a statement that does not start with a name"
msgstr "语句不是以名称开头"

#: src/macro/w42-vba.c:1770
msgid "labels are not supported"
msgstr "不支持标签"

#. Translators: %s is a macro keyword (Sub, Function, If, For, Do,
#. * Select Case or With): keep it in English.
#: src/macro/w42-vba.c:1803
#, c-format
msgid "%s is never ended"
msgstr "%s 没有结束"

#. Translators: "Sub" is a macro keyword: keep it in English.
#. * %s is the Sub's name.
#: src/macro/w42-vba.c:1820
#, c-format
msgid "There is no Sub named %s in this macro."
msgstr "此宏中没有名为 %s 的 Sub。"

#: src/main.c:115
