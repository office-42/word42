"%s\n"
"Spelling: %s  ·  Hyphenation: %s  ·  PDF import: %s"
msgstr ""
"Word42 %s\n"
"GTK %u.%u.%u (构建时版本 %d.%d.%d)  ·  GLib %u.%u.%u\n"
"Pango %s  ·  Cairo %s  ·  GdkPixbuf %s\n"
"%s\n"
"拼写：%s  ·  断字：%s  ·  PDF 导入：%s"

