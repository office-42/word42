#: src/ui/w42-window.c:5358
msgid ""
"A document that has never been saved, or that came from a format Word42 does "
"not write back, needs a name: use File > Save As for it."
msgstr ""
"从未保存过的文档，或来自 Word42 无法写回的格式的文档，需要指定名称：请对其使"
"用“文件 > 另存为”。"

#: src/ui/w42-window.c:5397 src/ui/w42-window.c:5439
msgid "Word42 could not read that file."
msgstr "Word42 无法读取该文件。"

#: src/ui/w42-window.c:5433
msgid "The two documents are the same."
msgstr "两个文档完全相同。"

#: src/ui/w42-window.c:5435
